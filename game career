function rotateBowler(){
  M.thisOverBowlerBalls = 0;
  for (var attempt = 0; attempt < 10; attempt++) {
    M.nextBowlerIdx = (M.nextBowlerIdx + 1) % M.bowlCandidates.length;
    var candidate = M.bowlCandidates[M.nextBowlerIdx];
    if (candidate && candidate.name !== (M.currentBowler && M.currentBowler.name)) {
      M.currentBowler = candidate;
      var bc = null;
      for (var i = 0; i < M.bowlCard.length; i++) if (M.bowlCard[i].name === candidate.name) bc = M.bowlCard[i];
      if (bc) M.bowlerStats = bc;
      return;
    }
  }
  M.currentBowler = M.bowlCandidates[0];
  M.bowlerStats = M.bowlCard[0];
}

