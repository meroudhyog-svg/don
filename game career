var CONDITIONS = {
  pitchDesc:'a good cricket wicket', pitchEffect:'Honours even',
  weather:'clear', weatherEffect:'Perfect conditions',
  windDir:'N', windSpeed:8, venue:'Stadium', dew:false
};

function generateConditions(){
  var types = [
    { desc:'green top',           effect:'Seamers will be dangerous' },
    { desc:'dry and dusty',        effect:'Spin will dominate' },
    { desc:'hard and bouncy',      effect:'Steep bounce expected' },
    { desc:'soft with turn',       effect:'Two-paced surface' },
    { desc:'a good cricket wicket',effect:'Even contest' }
  ];
  var w = [
    { w:'clear',    eff:'Perfect batting conditions' },
    { w:'overcast', eff:'Swing under lights' },
    { w:'humid',    eff:'Ball will do a bit' },
    { w:'warm',     eff:'Dry surface, spin helps' }
  ];
  var p = types[Math.floor(Math.random()*types.length)];
  var we = w[Math.floor(Math.random()*w.length)];
  CONDITIONS.pitchDesc = p.desc;
  CONDITIONS.pitchEffect = p.effect;
  CONDITIONS.weather = we.w;
  CONDITIONS.weatherEffect = we.eff;
  CONDITIONS.windDir = ['N','NE','E','SE','S','SW','W','NW'][Math.floor(Math.random()*8)];
  CONDITIONS.windSpeed = 5 + Math.floor(Math.random()*20);
  CONDITIONS.venue = ['Wankhede','Eden Gardens','Chinnaswamy',"Lord's",'MCG','Chepauk'][Math.floor(Math.random()*6)];
  CONDITIONS.dew = Math.random() < 0.5;
}

function faceMini(name){
  var url = (typeof getPhoto === 'function') ? getPhoto(name) : null;
  var ini = (typeof initialsOf === 'function') ? initialsOf(name) : '?';
  if (url) return '<img src="' + url + '" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'"><div class="ini" style="display:none">' + ini + '</div>';
  return '<div class="ini">' + ini + '</div>';
}

function pickKeyPlayers(teamId, count){
  if (typeof S === 'undefined' || !S.teams[teamId]) return [];
  var team = S.teams[teamId];
  var list = [];
  for (var i = 0; i < team.squad.length; i++){
    var p = S.players[team.squad[i]];
    if (!p || p.injury) continue;
    var fb = p.formState === 'hot' ? 1.3 : p.formState === 'good' ? 1.15 : p.formState === 'cold' ? 0.85 : 1;
    list.push({ p: p, score: (p.skill || 70) * fb * (1 - ((p.fatigue || 0) / 200)) });
  }
  list.sort(function(a,b){ return b.score - a.score; });
  return list.slice(0, count || 3);
}

function showPreMatchIntro(teamA, teamB){
  return new Promise(function(resolve){
    generateConditions();
    var ov = document.getElementById('pmiOverlay');
    if (!ov){
      ov = document.createElement('div');
      ov.id = 'pmiOverlay';
      ov.innerHTML = '<div id="pmiCard"></div>';
      document.body.appendChild(ov);
    }
    var card = ov.querySelector('#pmiCard');
    ov.classList.add('show');

    var tA = (typeof getTeam === 'function') ? getTeam(teamA) : { name: teamA };
    var tB = (typeof getTeam === 'function') ? getTeam(teamB) : { name: teamB };
    var badgeA = (typeof teamBadgeHtml === 'function') ? teamBadgeHtml(teamA, 56) : teamA;
    var badgeB = (typeof teamBadgeHtml === 'function') ? teamBadgeHtml(teamB, 56) : teamB;
    var xiA = (typeof pickSimXI === 'function') ? pickSimXI(tA).slice(0, 11) : [];
    var xiB = (typeof pickSimXI === 'function') ? pickSimXI(tB).slice(0, 11) : [];
    var keyA = pickKeyPlayers(teamA, 3);
    var keyB = pickKeyPlayers(teamB, 3);

    var stage = 0;
    var TOTAL = 4;
    var done = false;

    function finish(){
      if (done) return;
      done = true;
      clearInterval(autoTimer);
      ov.classList.remove('show');
      resolve();
    }

    function dotsHtml(active){
      var h = '<div class="pmi-dots">';
      for (var i = 0; i < TOTAL; i++){
        h += '<span class="pmi-dot' + (i === active ? ' active' : '') + '"></span>';
      }
      return h + '</div>';
    }

    function render(){
      var html = '';
      if (stage === 0){
        html = '<div class="pmi-kicker">Match Preview</div>' +
          '<div class="pmi-title">' + (typeof S !== 'undefined' && S.phase === 'championship' ? 'Championship' : 'Qualifier') + ' · Season ' + (typeof S !== 'undefined' ? S.season : 1) + '</div>' +
          '<div class="pmi-vs">' +
            '<div><div class="pmi-badge">' + badgeA + '</div><div class="pmi-teamName">' + (tA.name || teamA) + '</div></div>' +
            '<div class="pmi-vsText">VS</div>' +
            '<div><div class="pmi-badge">' + badgeB + '</div><div class="pmi-teamName">' + (tB.name || teamB) + '</div></div>' +
          '</div>' +
          '<div class="pmi-chips">' +
            '<span class="pmi-chip">📍 ' + CONDITIONS.venue + '</span>' +
            '<span class="pmi-chip">🏏 20 OVERS</span>' +
            '<span class="pmi-chip">📺 ' + CHANNELS[currentId].name + '</span>' +
          '</div>';
      } else if (stage === 1){
        function colHtml(xi, name){
          var h = '<div class="pmi-col"><div class="pmi-colHead">' + name + '</div>';
          for (var i = 0; i < xi.length; i++){
            var p = xi[i];
            h += '<div class="pmi-row" style="animation-delay:' + (i*0.05) + 's">' +
              '<div class="pmi-rowPic">' + faceMini(p.name) + '</div>' +
              '<div class="pmi-rowName">' + p.name + '</div>' +
              '<div class="pmi-rowOvr">' + (p.ovr || p.skill || 70) + '</div></div>';
          }
          return h + '</div>';
        }
        html = '<div class="pmi-kicker">Playing XIs</div>' +
          '<div class="pmi-title">Team Lineups</div>' +
          '<div class="pmi-xi">' + colHtml(xiA, tA.name) + colHtml(xiB, tB.name) + '</div>';
      } else if (stage === 2){
        html = '<div class="pmi-kicker">Ground Report</div>' +
          '<div class="pmi-title">Today\'s Conditions</div>' +
          '<div class="pmi-conds">' +
            '<div class="pmi-cond"><div class="pmi-condIcon">🟫</div><div class="pmi-condLabel">Pitch</div><div class="pmi-condVal">' + CONDITIONS.pitchDesc + '</div><div style="font-size:10px;color:#7dff7d;margin-top:4px;font-weight:700">' + CONDITIONS.pitchEffect + '</div></div>' +
            '<div class="pmi-cond"><div class="pmi-condIcon">🌤️</div><div class="pmi-condLabel">Weather</div><div class="pmi-condVal">' + CONDITIONS.weather + '</div><div style="font-size:10px;color:#7dff7d;margin-top:4px;font-weight:700">' + CONDITIONS.weatherEffect + '</div></div>' +
            '<div class="pmi-cond"><div class="pmi-condIcon">💨</div><div class="pmi-condLabel">Wind</div><div class="pmi-condVal">' + CONDITIONS.windDir + ' · ' + CONDITIONS.windSpeed + ' km/h</div></div>' +
            '<div class="pmi-cond"><div class="pmi-condIcon">💧</div><div class="pmi-condLabel">Dew</div><div class="pmi-condVal">' + (CONDITIONS.dew ? 'Expected' : 'None') + '</div></div>' +
          '</div>';
      } else if (stage === 3){
        function keyHtml(list, name){
          var h = '<div class="pmi-keyCol"><div class="pmi-keyHead">⭐ ' + name + '</div>';
          for (var i = 0; i < list.length; i++){
            var kp = list[i].p;
            var fl = { hot:'🔥', good:'✦', neutral:'●', cold:'❄', formless:'▼' }[kp.formState || 'neutral'];
            var fc = { hot:'#ff4400', good:'#ffaa00', neutral:'#8fa0b8', cold:'#4db8ff', formless:'#555' }[kp.formState || 'neutral'];
            h += '<div class="pmi-keyRow">' +
              '<div class="pmi-keyPic">' + faceMini(kp.name) + '</div>' +
              '<div class="pmi-keyName">' + kp.name + '</div>' +
              '<div class="pmi-keyForm" style="color:' + fc + '">' + fl + '</div></div>';
          }
          return h + '</div>';
        }
        html = '<div class="pmi-kicker">Players to Watch</div>' +
          '<div class="pmi-title">Key Men</div>' +
          '<div class="pmi-keys">' + keyHtml(keyA, tA.name) + keyHtml(keyB, tB.name) + '</div>';
      }
      html += '<button class="pmi-btn" id="pmiNext">' + (stage === TOTAL-1 ? '▶ Start Match' : 'Next →') + '</button>';
      html += dotsHtml(stage);
      card.innerHTML = html;
      var btn = card.querySelector('#pmiNext');
      if (btn) btn.onclick = function(){
        if (stage < TOTAL - 1){ stage++; render(); }
        else finish();
      };
    }

    render();
    var autoTimer = setInterval(function(){
      if (stage < TOTAL - 1){ stage++; render(); }
      else { clearInterval(autoTimer); }
    }, 4000);
  });
}

