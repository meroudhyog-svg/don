/* ═══════════════════════════════════════════════════════════
   CAREER ACTIONS
   ═══════════════════════════════════════════════════════════ */
function userQualifierFixtures(){
  return S.fixtures.filter(function(f){ return f.stage === 'qualifier' && (f.home === S.userTeamId || f.away === S.userTeamId); });
}
function userQualifiersDone(){
  var fx = userQualifierFixtures();
  return fx.length >= 3 && fx.every(function(f){ return f.played; });
}
function nextUserQualifier(){
  var fx = userQualifierFixtures();
  for (var i = 0; i < fx.length; i++) if (!fx[i].played) return fx[i];
  return null;
}

async function handleAction(action){
  if (action === 'startSeason') {
    S.phase = 'qualifiers';
    generateFixtures();
    addNews('Qualifier fixtures generated.', 'info');
    save(); renderCareer();
    return;
  }
  if (action === 'playNext') {
    if (S.phase === 'qualifiers') {
      if (userQualifiersDone()) return transitionToChampionship();
      var fx = nextUserQualifier();
      if (!fx) { generateFixtures(); save(); renderCareer(); return; }
      await launchQualifierMatch(fx);
      return;
    }
  }
  if (action === 'simRound') {
    if (S.phase === 'qualifiers') {
      S.fixtures.filter(function(f){ return f.stage === 'qualifier' && !f.played; }).forEach(function(f){
        f.result = simulateMatch(f.home, f.away);
        f.played = true;
        applyResult(f);
      });
      addNews('All qualifier matches simulated.', 'info');
      if (userQualifiersDone()) transitionToChampionship();
      else { save(); renderCareer(); }
      return;
    }
  }
  if (action === 'champTab') {
    UI_TAB = 'champ';
    document.querySelectorAll('.cr-tab').forEach(function(t){ t.classList.toggle('active', t.dataset.tab === 'champ'); });
    renderCareerTab();
    return;
  }
  if (action === 'nextSeason') {
    runSeasonProgression();
    S.season++;
    S.phase = 'preseason';
    Object.values(S.teams).forEach(function(t){
      t.season = { P:0, W:0, L:0, Pts:0 };
      t.eliminated = false;
      t.champion = false;
    });
    S.fixtures = [];
    S.champState = null;
    addNews('Season ' + S.season + ' begins.', 'welcome');
    save(); renderCareer();
    return;
  }
}

function transitionToChampionship(){
  S.fixtures.filter(function(f){ return f.stage === 'qualifier' && !f.played; }).forEach(function(f){
    f.result = simulateMatch(f.home, f.away);
    f.played = true;
    applyResult(f);
  });
  S.phase = 'championship';
  initChampionship();
  save();
  UI_TAB = 'champ';
  document.querySelectorAll('.cr-tab').forEach(function(t){ t.classList.toggle('active', t.dataset.tab === 'champ'); });
  renderCareer();
  showToast('Championship ready!');
}

async function launchQualifierMatch(fx){
  var oppId = fx.home === S.userTeamId ? fx.away : fx.home;
  var userIsHome = fx.home === S.userTeamId;

  S.fixtures.filter(function(f){ return f.stage === 'qualifier' && f.round === fx.round && !f.played && f.id !== fx.id; }).forEach(function(f){
    f.result = simulateMatch(f.home, f.away);
    f.played = true;
    applyResult(f);
  });

  rebuildMatchTeams();
  M.userCode = S.userTeamId;

  var res = await showToss(S.userTeamId, oppId);

  startMatch({
    userCode: S.userTeamId,
    battingTeam: res.battingTeam,
    bowlingTeam: res.bowlingTeam,
    overs: 20,
    onComplete: function(result){
      var inn1 = result.innings1, inn2 = result.innings2;
      fx.result = {
        homeRuns: userIsHome ? inn1.runs : inn2.runs,
        homeWkts: userIsHome ? inn1.wickets : inn2.wickets,
        awayRuns: userIsHome ? inn2.runs : inn1.runs,
        awayWkts: userIsHome ? inn2.wickets : inn1.wickets,
        winner: result.winner
      };
      fx.played = true;
      applyResult(fx);
      advancePlayerCondition(S.userXI);
      applyMatchProgression(result, S.userXI);
      save();

      var screens = document.querySelectorAll('.screen');
      for (var i = 0; i < screens.length; i++) screens[i].classList.remove('active');
      openCareer();

      if (userQualifiersDone() && S.phase === 'qualifiers') {
        setTimeout(transitionToChampionship, 600);
      }
    }
  });
}

async function playGroupMatch(){
  var CS = S.champState;
  var round = CS.groupRound;
  var fx = CS.groupFixtures.find(function(f){ return f.round === round && !f.played && (f.home === S.userTeamId || f.away === S.userTeamId); });
  if (!fx) { showToast('No match for you this round'); return; }

  CS.groupFixtures.filter(function(f){ return f.round === round && !f.played && f.id !== fx.id; }).forEach(function(f){
    f.result = simulateMatch(f.home, f.away);
    f.played = true;
  });

  var oppId = fx.home === S.userTeamId ? fx.away : fx.home;
  var userIsHome = fx.home === S.userTeamId;

  rebuildMatchTeams();
  M.userCode = S.userTeamId;

  var res = await showToss(S.userTeamId, oppId);
  startMatch({
    userCode: S.userTeamId,
    battingTeam: res.battingTeam,
    bowlingTeam: res.bowlingTeam,
    overs: 20,
    onComplete: function(result){
      var inn1 = result.innings1, inn2 = result.innings2;
      fx.result = {
        homeRuns: userIsHome ? inn1.runs : inn2.runs,
        homeWkts: userIsHome ? inn1.wickets : inn2.wickets,
        awayRuns: userIsHome ? inn2.runs : inn1.runs,
        awayWkts: userIsHome ? inn2.wickets : inn1.wickets,
        winner: result.winner
      };
      fx.played = true;
      advancePlayerCondition(S.userXI);
      applyMatchProgression(result, S.userXI);
      CS.groupRound++;
      if (CS.groupRound > CS.maxGroupRounds) finishGroupStage();
      save();

      var screens = document.querySelectorAll('.screen');
      for (var i = 0; i < screens.length; i++) screens[i].classList.remove('active');
      openCareer();
      UI_TAB = 'champ';
      document.querySelectorAll('.cr-tab').forEach(function(t){ t.classList.toggle('active', t.dataset.tab === 'champ'); });
      renderCareer();
    }
  });
}

async function playKOMatch(fx){
  var CS = S.champState;
  var cur = CS.knockoutRound;
  (CS.knockout[cur] || []).filter(function(f){ return !f.played && f.id !== fx.id; }).forEach(function(f){
    f.result = simulateMatch(f.home, f.away);
    f.played = true;
  });

  var oppId = fx.home === S.userTeamId ? fx.away : fx.home;
  var userIsHome = fx.home === S.userTeamId;

  rebuildMatchTeams();
  M.userCode = S.userTeamId;

  var res = await showToss(S.userTeamId, oppId);
  startMatch({
    userCode: S.userTeamId,
    battingTeam: res.battingTeam,
    bowlingTeam: res.bowlingTeam,
    overs: 20,
    onComplete: function(result){
      var inn1 = result.innings1, inn2 = result.innings2;
      fx.result = {
        homeRuns: userIsHome ? inn1.runs : inn2.runs,
        homeWkts: userIsHome ? inn1.wickets : inn2.wickets,
        awayRuns: userIsHome ? inn2.runs : inn1.runs,
        awayWkts: userIsHome ? inn2.wickets : inn1.wickets,
        winner: result.winner
      };
      fx.played = true;
      advanceKnockout();
      if (CS.champion) S.phase = 'seasonEnd';
      advancePlayerCondition(S.userXI);
      applyMatchProgression(result, S.userXI);
      save();

      var screens = document.querySelectorAll('.screen');
      for (var i = 0; i < screens.length; i++) screens[i].classList.remove('active');
      openCareer();
      UI_TAB = 'champ';
      document.querySelectorAll('.cr-tab').forEach(function(t){ t.classList.toggle('active', t.dataset.tab === 'champ'); });
      renderCareer();
    }
  });
}

