function pickSimXI(team){
  if (!team || !team.players || !team.players.length) return [];
  var sorted = team.players.slice().sort(function(a,b){ return b.ovr - a.ovr; });
  var picked = [];
  var wk = null;
  for (var i = 0; i < sorted.length; i++) if (sorted[i].role === 'WK') { wk = sorted[i]; break; }
  if (wk) picked.push(wk);
  for (var j = 0; j < sorted.length; j++) {
    var p = sorted[j];
    if (picked.indexOf(p) >= 0) continue;
    if ((p.role === 'BOWL' || p.role === 'BWL' || p.role === 'AR') && picked.filter(function(x){ return x.role === 'BOWL' || x.role === 'BWL' || x.role === 'AR'; }).length < 5) picked.push(p);
  }
  for (var k = 0; k < sorted.length; k++) {
