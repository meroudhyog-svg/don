function rollAIShot(length){
  var bat = PLAYER_DATA[M.striker.name] || { bat: 70, aggression: 70 };
  var aggr = (bat.aggression || 70) / 100;
  var batSkill = (bat.bat || 70) / 100;
  var missChance = 0.20, outChance = 0.04, loftBias = 0.35;
  if (length === 'FULL') { missChance = 0.10; outChance = 0.06; loftBias = 0.55; }
  else if (length === 'SHORT') { missChance = 0.30; outChance = 0.08; loftBias = 0.65; }
  missChance *= (1 - aggr * 0.3) * (1 - batSkill * 0.2);
  outChance *= (0.6 + aggr * 0.8);
  var roll = Math.random();
  if (roll < missChance) return { type: 'miss' };
  if (roll < missChance + outChance) return { type: 'out' };
  var shotRoll = Math.random();
  var shot, type;
  if (shotRoll < loftBias * 0.5) { shot = 'LOFT'; type = 'six'; }
  else if (shotRoll < loftBias * 0.8) { shot = 'LOFT'; type = 'four'; }
  else if (shotRoll < 0.70) { shot = 'GROUND'; type = Math.random() < 0.3 ? 'four' : (Math.random() < 0.5 ? 'two' : 'one'); }
  else { shot = 'DEFEND'; type = Math.random() < 0.4 ? 'one' : 'dot'; }
  return { type: type, shot: shot };
}

function synthesizeAIShot(aiIntent){
  var shotType = aiIntent.shot === 'LOFT' ? 'LOFT' : 'GROUND';
  var dirPool = shotType === 'LOFT'
    ? [-45, 0, 45, 90, -90, 135, -135]
    : [-70, -45, -20, 0, 20, 45, 70, 90, -90, 135, -135];
  var direction = dirPool[Math.floor(Math.random() * dirPool.length)];
  var batData = PLAYER_DATA[M.striker.name] || { bat: 70, tech: 70 };
  var skill = ((batData.bat || 70) * 0.6 + (batData.tech || 70) * 0.4) / 100;
  var r = Math.random();
  var quality;
  if (r < 0.15 + skill * 0.35) quality = 'perfect';
  else if (r < 0.45 + skill * 0.35) quality = 'good';
  else if (r < 0.85) quality = 'okay';
  else quality = 'poor';
  return { type: shotType, direction: direction, timing: { quality: quality } };
}

