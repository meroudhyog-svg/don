          + '<div class="champ-fx-score ' + (wonH ? 'won' : '') + '">' + (f2.result ? f2.result.homeRuns + '/' + f2.result.homeWkts : '—') + '</div>'
          + '<div class="champ-fx-mid">V</div>'
          + '<div class="champ-fx-score ' + (wonA ? 'won' : '') + '">' + (f2.result ? f2.result.awayRuns + '/' + f2.result.awayWkts : '—') + '</div>'
          + '<div class="champ-fx-team" style="text-align:left;color:' + (wonA ? '#00ff88' : '#fff') + '">' + (a2 ? a2.shortName : f2.away) + '</div>'
          + '</div>';
      }
      fh += '</div>';
    }
    body.innerHTML = fh || '<div class="cr-card"><div class="cr-empty">No fixtures yet</div></div>';
    return;
  }

  if (UI_TAB === 'table') {
    var allT = Object.values(S.teams).sort(function(a,b){
      if (b.season.Pts !== a.season.Pts) return b.season.Pts - a.season.Pts;
      if (b.season.W !== a.season.W) return b.season.W - a.season.W;
      return b.rating.ovr - a.rating.ovr;
    });
    var th = '<div class="cr-card"><div class="cr-card-title">League Table</div><table class="tbl">'
      + '<thead><tr><th>#</th><th>Team</th><th>P</th><th>W</th><th>L</th><th>Pts</th></tr></thead><tbody>';
    for (var ti2 = 0; ti2 < allT.length; ti2++) {
      var t2 = allT[ti2];
      var me = t2.id === S.userTeamId;
      var cutoff = ti2 === 31;
      th += '<tr class="' + (me ? 'me' : '') + ' ' + (cutoff ? 'cutoff' : '') + '">'
        + '<td>' + (ti2+1) + '</td>'
        + '<td>' + t2.shortName + '</td>'
        + '<td>' + t2.season.P + '</td><td>' + t2.season.W + '</td><td>' + t2.season.L + '</td>'
        + '<td class="pts">' + t2.season.Pts + '</td></tr>';
    }
    th += '</tbody></table></div>';
    body.innerHTML = th;
    return;
  }

  if (UI_TAB === 'champ') {
    renderChampionshipTab();
    return;
  }

  if (UI_TAB === 'medical') {
    var squad3 = team.squad.map(function(pid){ return S.players[pid]; }).filter(function(p){ return p; });
    var injured = squad3.filter(function(p){ return p.injury; });
    var tired = squad3.filter(function(p){ return !p.injury && (p.fatigue||0) >= 60; });
    var fit = squad3.filter(function(p){ return isAvailable(p); });
    var secFn = function(title, list, color){
      var h = '<div class="cr-card"' + (color ? ' style="border-color:' + color + '"' : '') + '>'
        + '<div class="cr-card-title"' + (color ? ' style="color:' + color + '"' : '') + '>' + title + ' · ' + list.length + '</div>';
      if (!list.length) h += '<div class="cr-empty">None</div>';
      for (var i = 0; i < list.length; i++) {
        var p = list[i];
        h += '<div class="cr-row"><div class="cr-photo">' + faceHtml(p.name) + '</div>'
          + '<div style="flex:1;min-width:0"><div class="cr-name">' + p.name + ' <span class="cr-role ' + p.role + '">' + p.role + '</span></div>'
          + '<div class="cr-meta">' + (p.injury ? '<span style="color:#ff3366">' + p.injury.type + '</span>' : 'Fatigue: ' + (p.fatigue||0) + '%') + '</div></div></div>';
      }
      return h + '</div>';
    };
    body.innerHTML = secFn('Available', fit, '#00ff88') + secFn('Fatigued', tired, '#ff8844') + secFn('Injured', injured, '#ff3366');
    return;
