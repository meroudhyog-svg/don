function addMenuBtn(){
  var menu = document.getElementById('screen-menu');
  if (!menu) return false;
  if (document.getElementById('broadcasterBtn')) return true;
  var btn = document.createElement('button');
  btn.id = 'broadcasterBtn';
  btn.className = 'menu-btn';
  btn.textContent = '📺 Broadcaster';
  btn.style.cssText = 'margin-top:12px;background:linear-gradient(160deg,#4db8ff,#0a3a7a);border-color:#a0d4ff;color:#fff';
  var info = menu.querySelector('.menu-info');
  if (info) menu.insertBefore(btn, info);
  else menu.appendChild(btn);
  btn.addEventListener('click', openPicker);
  console.log('[BC] Broadcaster button added');
  return true;
}

function openPicker(){
  var old = document.getElementById('broadcasterPicker');
  if (old) old.remove();
  var ov = document.createElement('div');
  ov.id = 'broadcasterPicker';
  ov.style.cssText = 'position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,.94);display:flex;align-items:center;justify-content:center;padding:20px';
  var html = '<div style="width:100%;max-width:520px;background:linear-gradient(180deg,#0f1a35,#050810);border:2px solid #ffcc00;border-radius:16px;padding:22px">' +
    '<div style="font-family:Anton;font-size:20px;letter-spacing:3px;color:#ffcc00;text-align:center;margin-bottom:16px;text-transform:uppercase">Choose Broadcaster</div>' +
    '<div style="display:flex;flex-direction:column;gap:10px">';
  for (var id in CHANNELS){
    var c = CHANNELS[id];
    var isActive = id === currentId;
    html += '<div data-pick="' + id + '" style="padding:16px;border-radius:12px;cursor:pointer;display:flex;align-items:center;gap:14px;background:rgba(0,0,0,.4);border:2px solid ' + (isActive ? '#ffcc00' : 'rgba(255,255,255,.15)') + '">' +
      '<div style="width:52px;height:52px;border-radius:8px;background:#0a1830;display:flex;align-items:center;justify-content:center;font-size:26px;flex-shrink:0">' + c.emoji + '</div>' +
      '<div style="flex:1"><div style="font-family:Anton;font-size:15px;color:#fff;text-transform:uppercase">' + c.name + '</div>' +
      '<div style="font-size:11px;color:#8fa0b8;margin-top:2px">' + c.country + '</div></div>' +
      (isActive ? '<div style="color:#ffcc00;font-family:Anton;font-size:20px">✓</div>' : '') + '</div>';
  }
  html += '</div><button id="bcClose" style="width:100%;margin-top:16px;padding:12px;border-radius:10px;background:rgba(0,0,0,.5);border:1.5px solid rgba(255,204,0,.5);color:#ffcc00;font-family:Anton;font-size:12px;letter-spacing:2px;cursor:pointer;text-transform:uppercase">Close</button></div>';
  ov.innerHTML = html;
  document.body.appendChild(ov);

  ov.querySelectorAll('[data-pick]').forEach(function(el){
    el.addEventListener('click', function(){
      currentId = el.dataset.pick;
      try { localStorage.setItem(STORAGE, currentId); } catch(e){}
      ov.remove();
