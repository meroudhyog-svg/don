/* ═══════════════════════════════════════════════════════════
   3. TEMPLATE ENGINE
   ═══════════════════════════════════════════════════════════ */
function fillTemplate(line, ctx){
  return line.replace(/\{(\w+)\}/g, (m, key) => {
    return (ctx[key] !== undefined && ctx[key] !== null) ? ctx[key] : m;
  });
}

function pickLine(poolName, ctx){
  const pool = POOL[poolName];
  if (!pool || !pool.length) return '';
  const line = pool[Math.floor(Math.random() * pool.length)];
  return fillTemplate(line, ctx || {});
}

/* ═══════════════════════════════════════════════════════════
   4. CONTEXT BUILDER — reads from live game state
   ═══════════════════════════════════════════════════════════ */
function buildContext(){
  const ctx = {};
  if (typeof M === 'undefined') return ctx;

  /* Batting / bowling teams */
  if (M.battingTeam && typeof getTeam === 'function') {
    ctx.battingTeam = getTeam(M.battingTeam).name;
    ctx.battingCode = M.battingTeam;
  }
  if (M.bowlingTeam && typeof getTeam === 'function') {
    ctx.bowlingTeam = getTeam(M.bowlingTeam).name;
    ctx.bowlingCode = M.bowlingTeam;
  }

  /* Striker / bowler */
  if (M.striker) ctx.player = M.striker.name;
  if (M.currentBowler) ctx.bowler = M.currentBowler.name;
  if (M.nonStriker) ctx.nonStriker = M.nonStriker.name;

  /* Score situation */
  ctx.runs = M.runs || 0;
  ctx.wickets = M.wickets || 0;
  ctx.balls = M.balls || 0;
  ctx.overs = Math.floor((M.balls || 0) / 6) + '.' + ((M.balls || 0) % 6);

  /* Target / chase */
  if (M.target && M.target > 0 && M.target < 999999) {
    ctx.needed = Math.max(0, M.target - M.runs);
    ctx.target = M.target;
  } else {
    ctx.needed = '—';
    ctx.target = '—';
  }

  /* Striker stats */
  if (M.strikerStats) {
    const s = M.strikerStats;
    ctx.strikerRuns = s.runs || 0;
    ctx.strikerBalls = s.balls || 0;
    const sr = s.balls > 0 ? ((s.runs / s.balls) * 100).toFixed(1) : '0.0';
    ctx.sr = sr;
    ctx.average = s.balls > 0 ? (s.runs / (s.balls || 1) * 5).toFixed(1) : '0.0';
  }

  /* Bowler stats */
  if (M.bowlerStats) {
    const b = M.bowlerStats;
    ctx.figures = (b.wickets || 0) + '/' + (b.runs || 0);
    ctx.bowlerOvers = Math.floor((b.balls || 0) / 6) + '.' + ((b.balls || 0) % 6);
  }

  /* Partnership */
  if (M.partnerships && M.partnerships.length) {
    const p = M.partnerships[M.partnerships.length - 1];
    ctx.partnership = p.total || 0;
    ctx.partnershipBalls = p.balls || 0;
  }

  /* Career context */
  if (typeof S !== 'undefined' && S) {
    ctx.season = S.season || 1;

    /* Player career lookup */
    const player = findPlayerByName(M.striker && M.striker.name);
    if (player && player.career) {
      ctx.careerRuns = player.career.R || 0;
      ctx.careerWkts = player.career.W || 0;
      ctx.matches = player.career.M || 0;
      ctx.potm = player.career.POTM || 0;
      ctx.age = player.age || '—';
      const avg = (player.career.dismissed > 0) ? (player.career.R / player.career.dismissed).toFixed(1) : '—';
      ctx.careerAvg = avg;
    }
    const seasonS = findPlayerByName(M.striker && M.striker.name);
    if (seasonS && seasonS.season) {
      ctx.seasonRuns = seasonS.season.R || 0;
      ctx.seasonMatches = seasonS.season.M || 0;
      ctx.seasonWkts = seasonS.season.W || 0;
    }
  }

  return ctx;
}

function findPlayerByName(name){
  if (!name || typeof S === 'undefined' || !S.players) return null;
  const ids = Object.keys(S.players);
  for (let i = 0; i < ids.length; i++) {
    if (S.players[ids[i]].name === name) return S.players[ids[i]];
  }
  return null;
}

/* ═══════════════════════════════════════════════════════════
   5. OTHER-MATCH LIVE TRACKER
   Simulates "live scores" of other fixtures happening
   ═══════════════════════════════════════════════════════════ */
const LiveTracker = {
  matches: [],

  init(){
    if (typeof S === 'undefined' || !S.fixtures) return;
    if (typeof S.userTeamId === 'undefined') return;

    this.matches = [];
    const others = S.fixtures.filter(f =>
      !f.played &&
      f.home !== S.userTeamId &&
      f.away !== S.userTeamId
    );
    const picked = others.slice(0, 4);

    for (const f of picked) {
      const home = S.teams[f.home];
      const away = S.teams[f.away];
      if (!home || !away) continue;
      this.matches.push({
        homeCode: f.home,
        awayCode: f.away,
        homeName: home.name,
        awayName: away.name,
        battingFirst: Math.random() < 0.5 ? 'home' : 'away',
        runs: 0,
        wickets: 0,
        balls: 0,
        target: null,
        done: false,
        result: ''
      });
    }
  },

  tick(){
    for (const m of this.matches) {
      if (m.done) continue;
      /* Advance by 1 ball */
      if (Math.random() < 0.15) {
        m.wickets++;
        if (m.wickets >= 10) {
          m.done = true;
          m.result = 'All out for ' + m.runs;
        }
      } else {
        const r = Math.random();
        if (r < 0.55) m.runs += Math.floor(Math.random() * 3);
        else if (r < 0.85) m.runs += 4;
        else m.runs += 6;
      }
      m.balls++;
      if (m.balls >= 120) {
        m.done = true;
        m.result = 'Innings complete: ' + m.runs + '/' + m.wickets;
      }
    }
  },

  getSnapshot(){
    if (!this.matches.length) return null;
    const m = this.matches[Math.floor(Math.random() * this.matches.length)];
    return {
      otherTeam1: m.battingFirst === 'home' ? m.homeName : m.awayName,
      otherTeam2: m.battingFirst === 'home' ? m.awayName : m.homeName,
      otherScore1: m.runs + '/' + m.wickets + ' (' + Math.floor(m.balls/6) + '.' + (m.balls%6) + ')',
      otherStadium: ['Wankhede', 'Lord\'s', 'MCG', 'Eden Gardens', 'Chinnaswamy'][Math.floor(Math.random()*5)],
      otherTarget: m.target || 180,
      otherMargin: m.done ? m.result : 'in progress',
      otherNeed: m.done ? '—' : Math.max(0, 180 - m.runs)
    };
  }
};

/* ═══════════════════════════════════════════════════════════
   6. PRE-MATCH SHOW (3 pages)
   ═══════════════════════════════════════════════════════════ */
