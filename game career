async function startMatch(cfg){
  cfg = cfg || {};
  OVERS = cfg.overs || 20;
  TOTAL_BALLS = OVERS * 6;

  var batCode = cfg.battingTeam;
  var bowlCode = cfg.bowlingTeam;

  var battingXI = pickSimXI(getTeam(batCode));
  var bowlingXI = pickSimXI(getTeam(bowlCode));

  M.batCard = battingXI.map(function(p){ return { name:p.name, runs:0, balls:0 }; });
  var bowlCandidates = bowlingXI.filter(function(p){ return p.role === 'BWL' || p.role === 'BOWL' || p.role === 'AR'; });
  var bowlPick = bowlCandidates.length >= 4 ? bowlCandidates : bowlingXI;
  M.bowlCard = bowlPick.map(function(p){ return { name:p.name, balls:0, runs:0, wickets:0 }; });

  M.battingXI = battingXI;
  M.bowlingXI = bowlingXI;
