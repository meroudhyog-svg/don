/* ═══════════════════════════════════════════════════════════
   3. BOWLER QUOTA — max 4 overs, no consecutive
   ═══════════════════════════════════════════════════════════ */
(function(){
  function install(){
    if (window._fpV3QuotaDone) return true;
    if (typeof window.rotateBowler !== 'function') return false;
    window._fpV3QuotaDone = true;
    var _rot = window.rotateBowler;
    window.rotateBowler = function(){
      try {
        if (typeof M === 'undefined') return _rot.apply(this, arguments);
        var last = M.currentBowler ? M.currentBowler.name : null;
        var orig = M.bowlCandidates;
        var filtered = (orig || []).filter(function(p){
          if (p.name === last) return false;
          for (var i = 0; i < M.bowlCard.length; i++){
            if (M.bowlCard[i].name === p.name){
              if (Math.floor(M.bowlCard[i].balls / 6) >= 4) return false;
              break;
            }
          }
          return true;
        });
        if (!filtered.length){
          filtered = (orig || []).filter(function(p){ return p.name !== last; });
          if (!filtered.length) filtered = orig || [];
        }
        M.bowlCandidates = filtered;
        try { return _rot.apply(this, arguments); }
        finally { M.bowlCandidates = orig; }
      } catch(e){ console.error('[fpV3 quota]', e); return _rot.apply(this, arguments); }
    };
    console.log('%c✅ Bowler quota enforced (v3)', 'color:#00ff88;font-weight:bold;font-size:12px');
    return true;
  }
  var iv = setInterval(function(){ if (install()) clearInterval(iv); }, 500);
  setTimeout(install, 1500);
  setTimeout(install, 3000);
})();

