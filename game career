/* ═══════════════════════════════════════════════════════════
   7. LIVE COMMENTARY OUTPUT
   ═══════════════════════════════════════════════════════════ */
let CURRENT_PAIR = pickCommentatorPair();
let COMMENTARY_HISTORY = [];
let FILLER_TIMER = null;

function commentate(text, speakerIdx){
  if (!text) return;
  const speaker = CURRENT_PAIR[speakerIdx || 0];
  const entry = {
    speaker: speaker.name,
    emoji: speaker.emoji,
    text,
    time: Date.now()
  };
  COMMENTARY_HISTORY.push(entry);
  if (COMMENTARY_HISTORY.length > 200) COMMENTARY_HISTORY.shift();

  /* Render to existing commentary box */
  const el = document.getElementById('commentaryLine');
  if (el) {
    el.innerHTML =
      '<span style="color:#ffcc00;font-weight:700">' + speaker.emoji + ' ' + speaker.name + ':</span> ' +
      '<span style="color:#d8e0ec">' + text + '</span>';
  }

  /* Also log to console for dev */
  console.log('🎙️ [' + speaker.name + '] ' + text);
}

/* ═══════════════════════════════════════════════════════════
   8. HOOKS
   ═══════════════════════════════════════════════════════════ */

/* ─── Hook startMatch to fire pre-match show ─── */
function hookStartMatch(){
  if (typeof window.startMatch !== 'function' || window._commStartMatch) return false;
  window._commStartMatch = true;
  const orig = window.startMatch;

  window.startMatch = function(cfg){
    /* Fresh commentator pair each match */
    CURRENT_PAIR = pickCommentatorPair();
    COMMENTARY_HISTORY = [];

    /* Init other-match tracker */
    LiveTracker.init();

    /* Fire pre-match show asynchronously */
    setTimeout(() => runPreMatchShow(), 300);

    return orig.apply(this, arguments);
  };
  return true;
}

async function runPreMatchShow(){
  const pages = buildPreMatchShow();
  const sleep = ms => new Promise(r => setTimeout(r, ms));

  commentate('Welcome to the coverage. ' + CURRENT_PAIR[0].name + ' alongside ' + CURRENT_PAIR[1].name + '.', 0);
  await sleep(3500);

  for (let p = 0; p < pages.length; p++) {
    for (const line of pages[p]) {
      commentate(line, p % 2);   /* alternate speakers */
      await sleep(3200);
    }
  }
  commentate('Right, here we go. First ball coming up.', 1);
}

/* ─── Hook showFeedback for live events ─── */
function hookShowFeedback(){
  if (typeof window.showFeedback !== 'function' || window._commFeedback) return false;
  window._commFeedback = true;
  const orig = window.showFeedback;

  window.showFeedback = function(text, cls){
    const ctx = buildContext();

    /* Trigger commentary based on the feedback */
    setTimeout(() => {
      if (text === 'FOUR!')      commentate(pickLine('four', ctx), 0);
      else if (text === 'SIX!')  commentate(pickLine('six', ctx), 0);
      else if (text === 'BOWLED!') commentate(pickLine('wicketBowled', ctx), 1);
      else if (text === 'CAUGHT!') commentate(pickLine('wicketCaught', ctx), 1);
      else if (text === 'OUT!')    commentate(pickLine('wicketCaught', ctx), 1);
      else if (text === 'NO RUN')  commentate(pickLine('dotBall', ctx), 0);
      else if (text === '1 RUN')   commentate(pickLine('single', ctx), 1);
      else if (text === '2 RUNS')  commentate(pickLine('two', ctx), 0);
      else if (text === '3 RUNS')  commentate(pickLine('three', ctx), 1);
      else if (text === 'WIDE')    commentate('That is a wide. Extra run for ' + ctx.battingTeam + '.', 1);
      else if (text === 'NO BALL') commentate('No ball! Free hit coming up!', 0);
    }, 150);

    return orig.apply(this, arguments);
  };
  return true;
}

/* ─── Hook showMilestone for fifty/century ─── */
function hookMilestone(){
  if (typeof window.showMilestone !== 'function' || window._commMilestone) return false;
  window._commMilestone = true;
  const orig = window.showMilestone;

  window.showMilestone = function(name, label, big){
    const ctx = buildContext();
    setTimeout(() => {
      if (big === 50)  commentate(pickLine('fifty', ctx), 1);
      if (big === 100) commentate(pickLine('century', ctx), 1);
    }, 200);
    return orig.apply(this, arguments);
  };
  return true;
}

/* ─── Between-ball filler commentary ─── */
function startFiller(){
  if (FILLER_TIMER) clearInterval(FILLER_TIMER);
  FILLER_TIMER = setInterval(() => {
    /* Only when no ball in flight */
    if (typeof M === 'undefined' || M.busy) return;
    if (M.phase !== 'play') return;

    /* Tick other matches */
    LiveTracker.tick();

    /* Pick filler category */
    const r = Math.random();
    const ctx = buildContext();

    let line;
    if (r < 0.45) {
      /* Other match updates */
      const snap = LiveTracker.getSnapshot();
      if (snap) {
        Object.assign(ctx, snap);
        line = pickLine('fillerOtherMatches', ctx);
        commentate(line, 1);
        return;
      }
    }

    if (r < 0.75) {
      /* Stats / situation */
      line = pickLine('fillerStats', ctx);
      if (line) commentate(line, 0);
    } else {
      /* Banter */
      line = pickLine('fillerBanter', ctx);
      if (line) commentate(line, 1);
    }
  }, 8000);   /* every 8 seconds */
}

function stopFiller(){
  if (FILLER_TIMER) {
    clearInterval(FILLER_TIMER);
    FILLER_TIMER = null;
  }
}

/* ─── Hook finishMatch to stop filler ─── */
function hookFinishMatch(){
  if (typeof window.finishMatch !== 'function' || window._commFinish) return false;
  window._commFinish = true;
  const orig = window.finishMatch;

  window.finishMatch = function(){
    stopFiller();
    return orig.apply(this, arguments);
  };
  return true;
}

/* ─── Hook endInnings for innings break commentary ─── */
function hookEndInnings(){
  if (typeof window.endInnings !== 'function' || window._commInnings) return false;
  window._commInnings = true;
  const orig = window.endInnings;

  window.endInnings = function(){
    const ctx = buildContext();
    setTimeout(() => {
      commentate('That is the end of the innings. ' + (ctx.battingTeam || 'The batting side') +
        ' finish on ' + ctx.runs + '/' + ctx.wickets + '.', 0);
    }, 300);
    return orig.apply(this, arguments);
  };
  return true;
}

/* ═══════════════════════════════════════════════════════════
   9. INSTALL
   ═══════════════════════════════════════════════════════════ */
function install(){
  let count = 0;
  if (hookStartMatch())    count++;
  if (hookShowFeedback())  count++;
  if (hookMilestone())     count++;
  if (hookFinishMatch())   count++;
  if (hookEndInnings())    count++;
  startFiller();

  if (count >= 4) {
    console.log('%c✅ COMMENTARY v1 ACTIVE — ' + COMMENTATORS.length + ' commentators · ' +
      Object.keys(POOL).length + ' line categories',
      'color:#ffcc00;font-weight:bold;font-size:13px');
    return true;
  }
  return false;
}

const iv = setInterval(() => { if (install()) clearInterval(iv); }, 400);
setTimeout(install, 1500);
setTimeout(install, 3500);

/* Expose for debugging */
window.__commentate = commentate;
window.__buildPreMatchShow = buildPreMatchShow;
window.__LiveTracker = LiveTracker;

})();
</script>
