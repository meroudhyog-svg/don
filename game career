var pick = function(arr){ return arr[Math.floor(Math.random()*arr.length)]; };
var shuffle = function(arr){
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
};
