  fox: '<div style="background:linear-gradient(180deg,#0a1428,#03060f);border-radius:4px;border-top:2px solid #ffcc00;border-bottom:2px solid #ffcc00;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.75);height:52px;display:flex;align-items:stretch;font-family:Rajdhani,sans-serif">' +
    '<div style="width:56px;background:linear-gradient(160deg,#1a3a8a,#0a1a5a);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border-right:2px solid #ffcc00"><div style="font-size:16px;line-height:1">🇮🇳</div><div style="font-family:Anton;font-size:10px;color:#fff;letter-spacing:1px">IND</div></div>' +
    '<div style="background:linear-gradient(180deg,#ffd24a,#e8b520);display:flex;flex-direction:column;justify-content:center;align-items:center;padding:0 16px;min-width:100px;border-right:2px solid #ffcc00"><div style="font-family:Anton;font-size:24px;color:#0a1428;letter-spacing:.5px;line-height:1" data-bcast="score">0-0</div><div style="font-size:9px;color:#3a2010;letter-spacing:1.5px;font-weight:700;margin-top:2px" data-bcast="overs">OVERS 0.0</div></div>' +
    '<div style="flex:1;display:flex;align-items:center;background:linear-gradient(180deg,#0a1830,#050a1a);padding:0 14px;gap:18px;border-right:2px solid #ffcc00">' +
      '<div><div style="font-family:Anton;font-size:10px;color:#fff;letter-spacing:1.5px;opacity:.75" data-bcast="bat1">—</div><div style="font-family:Anton;font-size:14px;color:#fff;line-height:1.05;margin-top:1px" data-bcast="bat1r">0</div></div>' +
      '<div style="width:1px;height:28px;background:rgba(255,204,0,.35)"></div>' +
      '<div><div style="font-family:Anton;font-size:10px;color:#fff;letter-spacing:1.5px;opacity:.75" data-bcast="bat2">—</div><div style="font-family:Anton;font-size:14px;color:#fff;line-height:1.05;margin-top:1px" data-bcast="bat2r">0</div></div>' +
    '</div>' +
    '<div style="background:linear-gradient(180deg,#1a3a8a,#0a1a5a);display:flex;flex-direction:column;justify-content:center;align-items:flex-end;padding:0 14px;min-width:120px;border-right:2px solid #ffcc00"><div style="font-family:Anton;font-size:10px;color:#ffcc00;letter-spacing:1px" data-bcast="bowler">—</div><div style="font-family:Anton;font-size:14px;color:#fff;letter-spacing:1px;line-height:1.1;margin-top:2px" data-bcast="bowlerf">0-0</div></div>' +
    '<div style="width:56px;background:linear-gradient(160deg,#0a6b2c,#064018);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px"><div style="font-size:16px;line-height:1">🇦🇺</div><div style="font-family:Anton;font-size:10px;color:#fff;letter-spacing:1px">AUS</div></div>' +
  '</div>'
};

var scoreUpdateTimer = null;

function injectBroadcastScore(){
  var field = document.getElementById('screen-field');
  if (!field) return;

  var old = document.getElementById('bcastBoardWrap');
  if (old) old.remove();

  var wrap = document.createElement('div');
  wrap.id = 'bcastBoardWrap';
  wrap.innerHTML = BOARDS[currentId];
  field.appendChild(wrap);

  document.body.classList.add('broadcast-active');

  if (scoreUpdateTimer) clearInterval(scoreUpdateTimer);
  scoreUpdateTimer = setInterval(updateBroadcastScore, 200);
}

function updateBroadcastScore(){
  var wrap = document.getElementById('bcastBoardWrap');
  if (!wrap || typeof M === 'undefined') return;
  var $ = function(k){ return wrap.querySelector('[data-bcast="' + k + '"]'); };
  var sc = $('score'); if (sc) sc.textContent = (M.runs || 0) + '-' + (M.wickets || 0);
  var ov = $('overs');
  if (ov){
    var ovTxt = Math.floor((M.balls || 0)/6) + '.' + ((M.balls || 0)%6);
    ov.textContent = currentId === 'sony' ? ovTxt : 'OVERS ' + ovTxt;
  }
  var b1 = $('bat1'); if (b1) b1.textContent = M.striker ? M.striker.name.toUpperCase() : '—';
  var b1r = $('bat1r');
  if (b1r && M.strikerStats) b1r.innerHTML = M.strikerStats.runs + ' <span style="font-size:9px;opacity:.55;font-weight:700">(' + M.strikerStats.balls + ')</span>';
  var b2 = $('bat2'); if (b2) b2.textContent = M.nonStriker ? M.nonStriker.name.toUpperCase() : '—';
  var b2r = $('bat2r');
  if (b2r && M.nonStrikerStats) b2r.innerHTML = M.nonStrikerStats.runs + ' <span style="font-size:9px;opacity:.55;font-weight:700">(' + M.nonStrikerStats.balls + ')</span>';
  var bw = $('bowler'); if (bw) bw.textContent = M.currentBowler ? M.currentBowler.name.toUpperCase() : '—';
  var bwf = $('bowlerf');
  if (bwf && M.bowlerStats) bwf.innerHTML = (M.bowlerStats.wickets||0) + '-' + (M.bowlerStats.runs||0) + ' <span style="font-size:9px;opacity:.55;font-weight:700">(' + (Math.floor((M.bowlerStats.balls||0)/6) + '.' + ((M.bowlerStats.balls||0)%6)) + ')</span>';
}

function foldScore(){ var w = document.getElementById('bcastBoardWrap'); if (w) w.classList.add('folded'); }
function unfoldScore(){ var w = document.getElementById('bcastBoardWrap'); if (w) w.classList.remove('folded'); }

function removeBroadcastScore(){
  var old = document.getElementById('bcastBoardWrap');
  if (old) old.remove();
  if (scoreUpdateTimer){ clearInterval(scoreUpdateTimer); scoreUpdateTimer = null; }
  document.body.classList.remove('broadcast-active');
}

/* ═══════════════════════════════════════════════════════════
   5. Hook setStatus → fold/unfold scoreboard
   ═══════════════════════════════════════════════════════════ */
function hookSetStatus(){
  if (typeof window.setStatus !== 'function' || window._bcSetStatus) return false;
  window._bcSetStatus = true;
  var orig = window.setStatus;
  window.setStatus = function(t, fire){
    var r = orig.apply(this, arguments);
    try {
      if (t === 'Bowler running in…' || t === 'Running in…'){
        foldScore();
      } else if (t === 'Ready' || t === 'Pick your shot' || t === 'Pick your delivery'){
        unfoldScore();
      }
    } catch(e){}
    return r;
  };
  return true;
}

/* ═══════════════════════════════════════════════════════════
   6. Watch field screen
   ═══════════════════════════════════════════════════════════ */
function watchField(){
  var field = document.getElementById('screen-field');
  if (!field || field._bcWatched) return;
  field._bcWatched = true;
  new MutationObserver(function(){
    if (field.classList.contains('active')) setTimeout(injectBroadcastScore, 100);
    else removeBroadcastScore();
  }).observe(field, { attributes:true, attributeFilter:['class'] });
}

/* ═══════════════════════════════════════════════════════════
   7. Hook showToss → pre-match intro first
   ═══════════════════════════════════════════════════════════ */
function hookShowToss(){
  if (typeof window.showToss !== 'function' || window._pmiHook) return false;
  window._pmiHook = true;
  var orig = window.showToss;
  window.showToss = async function(teamA, teamB){
    await showPreMatchIntro(teamA, teamB);
    return orig.apply(this, arguments);
  };
  console.log('[PMI] Pre-match intro hooked');
  return true;
}

/* ═══════════════════════════════════════════════════════════
   8. Install loop — keeps trying until everything works
   ═══════════════════════════════════════════════════════════ */
function install(){
  var ok = 0;
  if (addMenuBtn()) ok++;
  if (hookSetStatus()) ok++;
  if (hookShowToss()) ok++;
  watchField();
  if (ok >= 3){
    console.log('%c✅ Broadcaster + intro + folding scoreboard ACTIVE', 'color:#00ff88;font-weight:bold;font-size:13px');
    return true;
  }
  return false;
}

var iv = setInterval(function(){ if (install()) clearInterval(iv); }, 500);
setTimeout(install, 1500);
setTimeout(install, 3000);
setTimeout(install, 5000);

window.__broadcaster = {
  get: function(){ return currentId; },
  set: function(id){ currentId = id; try { localStorage.setItem(STORAGE,id); } catch(e){}; injectBroadcastScore(); }
};
})();
</script>


