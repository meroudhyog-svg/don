/* ─── Standard banner renderer (with curve→flat bend) ─── */
function buildBanner(segs, total, dist, boardWidth, ad, bcfg, override){
  const g = svgEl('g', { class:'led-board' });
  const style = bcfg.bannerStyle || 'standard';
  const H = bcfg.height * (override.scaleH || 1);
  const bw = boardWidth * (override.scaleW || 1);
  const halfW = bw / 2;
  const N = style === 'screen' ? 12 : 8;
  const outward = bcfg.offset + (bcfg.extraOutward || 0) + 8;
  const CX = 703, CY = 600;
  const bezelPad = style === 'screen' ? 3 : style === 'mini' ? 0.8 : 1.5;
  const dx = bcfg.groupOffset.dx + (override.dx || 0);
  const dy = bcfg.groupOffset.dy + (override.dy || 0);
  const bend = (override.bend !== undefined) ? override.bend : (bcfg.bend !== undefined ? bcfg.bend : 1.0);

  const cO=[], cI=[], cBO=[], cBI=[];
  for (let i = 0; i <= N; i++){
    const d = dist - halfW + bw * (i/N);
    const p = pointAtDistance(segs, (d + total) % total);
    const nx = Math.sin(p.tangent), ny = -Math.cos(p.tangent);
    const toCX = CX - p.x, toCY = CY - p.y;
    const sgn = (nx*toCX + ny*toCY) > 0 ? -1 : 1;
    cO.push({ x:p.x + nx*sgn*(outward+H), y:p.y + ny*sgn*(outward+H) });
    cI.push({ x:p.x + nx*sgn*outward, y:p.y + ny*sgn*outward });
    cBO.push({ x:p.x + nx*sgn*(outward+H+bezelPad), y:p.y + ny*sgn*(outward+H+bezelPad) });
    cBI.push({ x:p.x + nx*sgn*(outward-bezelPad), y:p.y + ny*sgn*(outward-bezelPad) });
  }
  function flatten(arr){
    const a0 = arr[0], aN = arr[N], out = [];
    for (let i = 0; i <= N; i++){
      const t = i/N;
      out.push({ x:a0.x + (aN.x-a0.x)*t, y:a0.y + (aN.y-a0.y)*t });
    }
    return out;
  }
  const fO=flatten(cO), fI=flatten(cI), fBO=flatten(cBO), fBI=flatten(cBI);
  function blend(cA, fA, i){
    const c=cA[i], f=fA[i];
    return { x:(f.x + (c.x-f.x)*bend)+dx, y:(f.y + (c.y-f.y)*bend)+dy };
  }
  const outer=[], inner=[], bezelO=[], bezelI=[];
  for (let i = 0; i <= N; i++){
    outer.push(blend(cO, fO, i));
    inner.push(blend(cI, fI, i));
    bezelO.push(blend(cBO, fBO, i));
    bezelI.push(blend(cBI, fBI, i));
  }

  let bezelD = 'M ' + bezelO[0].x.toFixed(1) + ' ' + bezelO[0].y.toFixed(1);
  for (let i = 1; i <= N; i++) bezelD += ' L ' + bezelO[i].x.toFixed(1) + ' ' + bezelO[i].y.toFixed(1);
  for (let i = N; i >= 0; i--) bezelD += ' L ' + bezelI[i].x.toFixed(1) + ' ' + bezelI[i].y.toFixed(1);
  bezelD += ' Z';
  g.appendChild(svgEl('path', { d:bezelD, fill:style === 'screen' ? '#0a0a0a' : '#000' }));

  let d = 'M ' + outer[0].x.toFixed(1) + ' ' + outer[0].y.toFixed(1);
  for (let i = 1; i <= N; i++) d += ' L ' + outer[i].x.toFixed(1) + ' ' + outer[i].y.toFixed(1);
  for (let i = N; i >= 0; i--) d += ' L ' + inner[i].x.toFixed(1) + ' ' + inner[i].y.toFixed(1);
  d += ' Z';
  g.appendChild(svgEl('path', { d, fill:ad.bg, stroke:'rgba(0,0,0,.55)', 'stroke-width':0.4 }));
  const dotOp = style === 'screen' ? 0.5 : style === 'mini' ? 0.7 : 0.9;
  g.appendChild(svgEl('path', { d, fill:'url(#ledDots)', opacity:dotOp }));

  const gw = style === 'screen' ? 2.5 : style === 'mini' ? 0.8 : 1.4;
  const go = style === 'screen' ? 0.8 : style === 'mini' ? 0.35 : 0.5;
  g.appendChild(svgEl('path', { d, fill:'none', stroke:ad.bg, 'stroke-width':gw, opacity:go, filter:'url(#ledGlow)' }));

  const mid = pointAtDistance(segs, (dist + total) % total);
  const mx = (outer[Math.floor(N/2)].x + inner[Math.floor(N/2)].x) / 2;
  const my = (outer[Math.floor(N/2)].y + inner[Math.floor(N/2)].y) / 2;
  let ta = mid.tangent * 180 / Math.PI;
  if (ta > 90 || ta < -90) ta += 180;
  const sizeMul = style === 'screen' ? 0.5 : style === 'mini' ? 0.48 : 0.55;
  const tEl = svgEl('text', {
    x:mx.toFixed(1), y:(my+H*0.18).toFixed(1),
    'text-anchor':'middle', 'font-family':'Anton, sans-serif',
    'font-size':(H*sizeMul).toFixed(1), fill:ad.fg,
    'letter-spacing':style === 'screen' ? '1.5' : '0.5',
    transform:'rotate('+ta.toFixed(1)+' '+mx.toFixed(1)+' '+my.toFixed(1)+')'
  });
  tEl.textContent = ad.text;
  g.appendChild(tEl);

  let minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;
  for (let i = 0; i <= N; i++){
    minX = Math.min(minX, inner[i].x, outer[i].x);
    maxX = Math.max(maxX, inner[i].x, outer[i].x);
    minY = Math.min(minY, inner[i].y, outer[i].y);
    maxY = Math.max(maxY, inner[i].y, outer[i].y);
  }
  const pad = Math.max(H*0.5, 12);
  const hit = svgEl('rect', { x:(minX-pad).toFixed(1), y:(minY-pad).toFixed(1), width:(maxX-minX+pad*2).toFixed(1), height:(maxY-minY+pad*2).toFixed(1), fill:'transparent', 'pointer-events':'all' });
  hit.classList.add('led-hit');
  g.appendChild(hit);

  if (override.angle) g.setAttribute('transform', 'rotate('+override.angle+' '+mx.toFixed(1)+' '+my.toFixed(1)+')');
  g.dataset.cx = mx.toFixed(1); g.dataset.cy = my.toFixed(1);
  return g;
}

function buildBoard(segs, total, dist, boardWidth, ad, bcfg, override){
  override = override || {};
  if (override.hidden) return null;
  if (bcfg.bannerStyle === 'scoreboard'){
    const p = pointAtDistance(segs, (dist+total)%total);
    const nx = Math.sin(p.tangent), ny = -Math.cos(p.tangent);
    const toCX = 703 - p.x, toCY = 600 - p.y;
    const sgn = (nx*toCX + ny*toCY) > 0 ? -1 : 1;
    const outward = bcfg.offset + (bcfg.extraOutward || 0) + 8;
    return buildScoreboard(p, nx, ny, sgn, outward, bcfg, override);
  }
  return buildBanner(segs, total, dist, boardWidth, ad, bcfg, override);
}

/* ─── Content pool ─── */
function buildContentPool(){
  const pool = [];
  if (SETTINGS.showSponsors) SPONSORS.forEach(s => pool.push({ text:s.text, bg:s.bg, fg:s.fg }));
  if (SETTINGS.showTeams && typeof S !== 'undefined' && S.teams){
    const ut = S.teams[S.userTeamId];
    if (ut){
      pool.push({ text:ut.shortName || ut.name, bg:'#0a1830', fg:'#ffcc00' });
      Object.values(S.teams).forEach(t => {
        if (t.id !== ut.id && t.league === ut.league)
          pool.push({ text:t.shortName || t.name, bg:'#1a3a8a', fg:'#fff' });
      });
    }
  }
  if (SETTINGS.showTournament && typeof S !== 'undefined'){
    pool.push({ text:'SEASON ' + (S.season||1), bg:'#8a1a8a', fg:'#fff' });
    if (S.phase === 'qualifiers') pool.push({ text:'QUALIFIERS', bg:'#0a4a8a', fg:'#fff' });
    if (S.phase === 'championship') pool.push({ text:'CHAMPIONSHIP', bg:'#d42030', fg:'#fff' });
  }
  if (SETTINGS.showKnockouts && typeof S !== 'undefined' && S.champState){
    const ko = S.champState.knockoutRound;
    const labels = { R16:'ROUND OF 16', QF:'QUARTER FINAL', SF:'SEMI FINAL', Final:'FINAL' };
    if (labels[ko]) pool.push({ text:labels[ko], bg:'#ffd24a', fg:'#0a1428' });
    if (S.champState.champion) pool.push({ text:'CHAMPIONS', bg:'#ffd24a', fg:'#0a1428' });
  }
  if (!pool.length) SPONSORS.forEach(s => pool.push({ text:s.text, bg:s.bg, fg:s.fg }));
  return pool;
}

/* ─── Multi-banner renderer ─── */
function createLedRenderer(layer, settings, options){
  options = options || {};
  const draggable = !!options.draggable;
  const onDragEnd = options.onDragEnd || function(){};
  const onSelect = options.onSelect || function(){};
  const st = { boards: [], cursor: 0, rotT: null, scrollT: null, cycT: null, selectedIdx: null, selectedPreset: 'full' };
  const { segs, total } = computePerimeter();

  /* Flatten all enabled banners into a single list of {preset, boardIndex, el} */
  function buildAll(){
    layer.innerHTML = '';
    st.boards = [];
    const pool = buildContentPool();
    const bannerKeys = Object.keys(settings.banners);
    for (const pkey of bannerKeys){
      const bcfg = settings.banners[pkey];
      if (!bcfg.enabled) continue;
      const seg = bcfg.boardCount;
      const coverage = bcfg.coverage;
      const startDist = total * bcfg.startFraction;
      const arcLen = total * coverage;
      const spacing = arcLen / seg;
      const bw = spacing * bcfg.gap;
      for (let i = 0; i < seg; i++){
        const dist = (startDist + i*spacing + spacing/2) % total;
        const ad = pool[(st.cursor + i) % pool.length];
        const bo = bcfg.boardOverrides[i] || {};
        const el = buildBoard(segs, total, dist, bw, ad, bcfg, bo);
        if (!el){ st.boards.push({ preset:pkey, idx:i, el:null, dist, bw, ad, bcfg }); continue; }
        el.dataset.preset = pkey;
        el.dataset.idx = i;
        layer.appendChild(el);
        st.boards.push({ preset:pkey, idx:i, el, dist, bw, ad, bcfg });
        attachInteractions(el, pkey, i);
      }
    }
    applySelectionOutline();
  }

  function applySelectionOutline(){
    st.boards.forEach(b => {
      if (b && b.el && typeof b.el.querySelector === 'function'){
        const prev = b.el.querySelector('.sel-outline');
        if (prev) prev.remove();
      }
    });
    if (st.selectedIdx === null) return;
    const b = st.boards.find(x => x.preset === st.selectedPreset && x.idx === st.selectedIdx);
    if (!b || !b.el) return;
    const box = b.el.querySelector('.led-hit');
    if (!box) return;
    const outline = svgEl('rect', {
      x: box.getAttribute('x'), y: box.getAttribute('y'),
      width: box.getAttribute('width'), height: box.getAttribute('height'),
      fill:'none', stroke:'#00ff88', 'stroke-width':2,
      'stroke-dasharray':'6 4', 'pointer-events':'none'
    });
    outline.classList.add('sel-outline');
    b.el.appendChild(outline);
  }

  function attachInteractions(g, presetKey, idx){
    if (!draggable) return;
    g.style.cursor = 'pointer';
    g.style.pointerEvents = 'auto';
    let downT=0, downX=0, downY=0, dragging=false, startDx=0, startDy=0, isSingleDrag=false;

    function toSvgPoint(evt){
      const svg = layer.ownerSVGElement;
      const pt = svg.createSVGPoint();
      pt.x = evt.clientX; pt.y = evt.clientY;
      return pt.matrixTransform(svg.getScreenCTM().inverse());
    }

    function onDown(e){
      e.preventDefault(); e.stopPropagation();
      downT = Date.now();
      const pt = toSvgPoint(e);
      downX = pt.x; downY = pt.y;
      const bcfg = settings.banners[presetKey];
      const isSelected = (st.selectedIdx === idx && st.selectedPreset === presetKey);
      isSingleDrag = isSelected;
      const bo = bcfg.boardOverrides[idx] || {};
      startDx = isSingleDrag ? (bo.dx || 0) : (bcfg.groupOffset.dx || 0);
      startDy = isSingleDrag ? (bo.dy || 0) : (bcfg.groupOffset.dy || 0);
      dragging = true;
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);
    }

    function onMove(e){
      if (!dragging) return;
      const pt = toSvgPoint(e);
      const dxMove = pt.x - downX, dyMove = pt.y - downY;
      if (Math.abs(dxMove) < 2 && Math.abs(dyMove) < 2) return;
      const bcfg = settings.banners[presetKey];
      if (isSingleDrag){
        if (!bcfg.boardOverrides[idx]) bcfg.boardOverrides[idx] = {};
        bcfg.boardOverrides[idx].dx = startDx + dxMove;
        bcfg.boardOverrides[idx].dy = startDy + dyMove;
      } else {
        bcfg.groupOffset.dx = startDx + dxMove;
        bcfg.groupOffset.dy = startDy + dyMove;
      }
      buildAll();
    }

    function onUp(e){
      if (!dragging) return;
      dragging = false;
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onUp);
      const dt = Date.now() - downT;
      const pt = toSvgPoint(e);
      const moved = Math.hypot(pt.x - downX, pt.y - downY);
      if (dt < 300 && moved < 6){
        if (st.selectedIdx === idx && st.selectedPreset === presetKey){
          st.selectedIdx = null;
          onSelect(null);
        } else {
          st.selectedIdx = idx;
          st.selectedPreset = presetKey;
          onSelect({ preset: presetKey, idx });
        }
        applySelectionOutline();
        return;
      }
      onDragEnd();
    }
    g.addEventListener('pointerdown', onDown);
  }

  function start(){
    buildAll();
    stopAll();
    if (draggable) return;
    const iv = Math.max(2000, (settings.rotationSec || 30) * 1000);
    st.rotT = setInterval(() => {
      st.cursor++;
      buildAll();
    }, iv);
  }

  function stopAll(){
    if (st.rotT) clearInterval(st.rotT);
    if (st.scrollT) clearInterval(st.scrollT);
    if (st.cycT) clearInterval(st.cycT);
    st.rotT = st.scrollT = st.cycT = null;
  }

  function update(){ stopAll(); start(); }
  function redrawBoard(){ buildAll(); }
  function clearSelection(){ st.selectedIdx = null; applySelectionOutline(); }
  function deleteBoard(presetKey, idx){
    const bcfg = settings.banners[presetKey];
    if (!bcfg) return;
    if (!bcfg.boardOverrides[idx]) bcfg.boardOverrides[idx] = {};
    bcfg.boardOverrides[idx].hidden = true;
    st.selectedIdx = null;
    buildAll();
  }
  function resetBoard(presetKey, idx){
    const bcfg = settings.banners[presetKey];
    if (!bcfg || !bcfg.boardOverrides[idx]) return;
    delete bcfg.boardOverrides[idx];
    st.selectedIdx = null;
    buildAll();
  }
  function setBoardOverride(presetKey, idx, patch){
    const bcfg = settings.banners[presetKey];
    if (!bcfg) return;
    if (!bcfg.boardOverrides[idx]) bcfg.boardOverrides[idx] = {};
    Object.assign(bcfg.boardOverrides[idx], patch);
  }

  return {
    start, stop: stopAll, update, redrawBoard,
    state: st, buildAll,
    getBoardOverride: (presetKey, idx) => settings.banners[presetKey]?.boardOverrides?.[idx] || {},
    setBoardOverride,
    setSelected: (presetKey, i) => { st.selectedIdx = i; st.selectedPreset = presetKey; applySelectionOutline(); },
    clearSelection, deleteBoard, resetBoard
  };
}

