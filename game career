  var userCode = M.bowlingTeam;
  var aiCode = M.battingTeam;
  var userRuns = M.innings1.runs;
  var userWkts = M.innings1.wickets;
  var aiRuns = M.runs;
  var aiWkts = M.wickets;

  var winner;
  if (aiRuns > userRuns) winner = aiCode;
  else if (userRuns > aiRuns) winner = userCode;
  else winner = 'tie';

  var inn1 = { side: userCode, runs: userRuns, wickets: userWkts, balls: M.innings1.balls, batsmen: M.innings1.card, bowlers: M.innings1.bowlCard };
  var inn2 = { side: aiCode, runs: aiRuns, wickets: aiWkts, balls: M.balls, batsmen: M.batCard, bowlers: M.bowlCard };

  var uT = getTeam(userCode), oT = getTeam(aiCode);
  var title, sub;
  if (winner === 'tie') { title = 'Match Tied!'; sub = 'Scores level at ' + userRuns; }
  else if (winner === userCode) {
    title = uT.name + ' win!';
    var margin = userRuns - aiRuns;
    sub = 'Defended by ' + margin + ' run' + (margin === 1 ? '' : 's');
  } else {
    title = oT.name + ' win!';
    var wktsLeft = 10 - aiWkts;
    sub = 'Chased it down with ' + wktsLeft + ' wicket' + (wktsLeft === 1 ? '' : 's') + ' to spare';
  }
  $('meTitle').textContent = title;
  $('meBig').textContent = userRuns + '-' + userWkts + ' vs ' + aiRuns + '-' + aiWkts;
  $('meSub').textContent = sub;
  $('matchEndOverlay').classList.add('show');

  M._matchResult = {
    homeCode: userCode, awayCode: aiCode,
    innings1: inn1, innings2: inn2,
    winner: winner, userBatted: M.innings1.card, userBowled: M.bowlCard
  };
}

