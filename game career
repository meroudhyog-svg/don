     ═══════════════════════════════════════════════════════════ -->
<script>
(function(){
'use strict';

console.log('%c✅ POLISH v4 loading…', 'color:#00ff88;font-size:12px');

/* ═══════════════════════════════════════════════════════════
   1. FADED BANNERS · 10s ON / 50s OFF
   ═══════════════════════════════════════════════════════════ */
(function(){
    var s = document.createElement('style');
    s.textContent = [
        '#field .led-board:not([data-preset="scoreboard"]):not([data-preset="digital"]){',
            'opacity:0.55 !important;',
            'transition:opacity 0.7s ease !important;',
        '}',
        'body.banners-hidden #field .led-board:not([data-preset="scoreboard"]):not([data-preset="digital"]){',
            'opacity:0 !important;',
        '}'
    ].join('\n');
    document.head.appendChild(s);

    var state = 'on';
    var timer = null;
    function cycle(){
        clearTimeout(timer);
        if (state === 'on'){
            document.body.classList.remove('banners-hidden');
            timer = setTimeout(function(){
                state = 'off';
                document.body.classList.add('banners-hidden');
                cycle();
            }, 10000);
        } else {
            timer = setTimeout(function(){
                state = 'on';
                cycle();
            }, 50000);
        }
    }
    cycle();

    var field = document.getElementById('screen-field');
    if (field){
        new MutationObserver(function(){
            if (field.classList.contains('active')){
                state = 'on';
                document.body.classList.remove('banners-hidden');
                cycle();
            }
        }).observe(field, { attributes:true, attributeFilter:['class'] });
    }
})();

/* ═══════════════════════════════════════════════════════════
   2. COUNTDOWN DRAWN INSIDE THE DIGITAL BOARD (pure SVG)
   ═══════════════════════════════════════════════════════════ */
var svgNS = 'http://www.w3.org/2000/svg';

/* Return x,y,w,h in the board's LOCAL SVG coordinates */
function getBoardBox(board){
    /* Preferred: the .led-hit rect (covers the whole board) */
    var hit = board.querySelector('.led-hit');
    if (hit){
        try {
            var bb = hit.getBBox();
            if (bb && bb.width > 20 && bb.height > 15){
                return { x:bb.x, y:bb.y, w:bb.width, h:bb.height };
            }
        } catch(e){}
    }
    /* Fallback: largest black rect inside the board */
    var rects = board.querySelectorAll('rect');
    var best = null;
    for (var i = 0; i < rects.length; i++){
        var r = rects[i];
        var f = (r.getAttribute('fill') || '').toLowerCase();
        if (f === '#000' || f === '#000000' || f === 'black'){
            var x = parseFloat(r.getAttribute('x')) || 0;
            var y = parseFloat(r.getAttribute('y')) || 0;
            var w = parseFloat(r.getAttribute('width')) || 0;
            var h = parseFloat(r.getAttribute('height')) || 0;
            if (w > 40 && h > 25 && (!best || w*h > best.w*best.h)){
                best = { x:x, y:y, w:w, h:h };
            }
        }
    }
    return best;
}

/* Find the scoreboard / digital board on the field */
function findBigBoard(){
    var b = document.querySelector('#field .led-board[data-preset="scoreboard"]');
    if (b && getBoardBox(b)) return b;
    b = document.querySelector('#field .led-board[data-preset="digital"]');
    if (b && getBoardBox(b)) return b;
    /* Fallback: whichever led-board has the largest box */
    var all = document.querySelectorAll('#field .led-board');
    var bestB = null, bestArea = 0;
    for (var i = 0; i < all.length; i++){
        var bb = getBoardBox(all[i]);
        if (!bb) continue;
        var a = bb.w * bb.h;
        if (a > bestArea){ bestArea = a; bestB = all[i]; }
    }
    return bestB;
}

function paintBoard(content){
    var board = findBigBoard();
    if (!board) return false;
    var bb = getBoardBox(board);
    if (!bb) return false;

    /* Remove old overlay */
    var old = board.querySelector('.cd-overlay');
    if (old) old.remove();

    /* Group inherits board's transform (rotation) automatically */
    var g = document.createElementNS(svgNS, 'g');
    g.setAttribute('class', 'cd-overlay');
    g.setAttribute('pointer-events', 'none');

    /* Full black cover over the board's area */
    var cover = document.createElementNS(svgNS, 'rect');
    cover.setAttribute('x', bb.x.toFixed(1));
    cover.setAttribute('y', bb.y.toFixed(1));
    cover.setAttribute('width', bb.w.toFixed(1));
    cover.setAttribute('height', bb.h.toFixed(1));
    cover.setAttribute('fill', '#000');
    cover.setAttribute('opacity', '0.97');
    g.appendChild(cover);

    /* Dot-matrix texture (looks like an LED panel) */
    var dots = document.createElementNS(svgNS, 'rect');
    dots.setAttribute('x', bb.x.toFixed(1));
    dots.setAttribute('y', bb.y.toFixed(1));
    dots.setAttribute('width', bb.w.toFixed(1));
    dots.setAttribute('height', bb.h.toFixed(1));
    dots.setAttribute('fill', 'url(#ledDots)');
    dots.setAttribute('opacity', '0.55');
    g.appendChild(dots);

    /* Countdown number (or LET'S PLAY) */
    var isPlay = (content === "LET'S PLAY");
    var fs = Math.min(bb.h * 0.55, bb.w * 0.40);
    var txt = document.createElementNS(svgNS, 'text');
    txt.setAttribute('x', (bb.x + bb.w / 2).toFixed(1));
    txt.setAttribute('y', (bb.y + bb.h / 2).toFixed(1));
    txt.setAttribute('text-anchor', 'middle');
    txt.setAttribute('dominant-baseline', 'middle');
    txt.setAttribute('font-family', 'Anton, sans-serif');
    txt.setAttribute('font-size', fs.toFixed(1));
    txt.setAttribute('font-weight', 'bold');
    txt.setAttribute('letter-spacing', '2');
    txt.setAttribute('fill', isPlay ? '#00ff88' : '#ffcc00');
    txt.setAttribute('style',
        'filter: drop-shadow(0 0 12px ' + (isPlay ? '#00ff88' : '#ffcc00') + ') ' +
                'drop-shadow(0 0 30px ' + (isPlay ? '#00ff88' : '#ff6600') + ');'
    );
    txt.textContent = content;
    g.appendChild(txt);

    board.appendChild(g);
    return true;
}

function clearBoardOverlay(){
    var els = document.querySelectorAll('#field .cd-overlay');
    for (var i = 0; i < els.length; i++) els[i].remove();
}

/* Glue loop — stadium module rebuilds the board every few seconds,
   so we re-inject our overlay if it disappears mid-countdown */
var _active = false;
var _current = null;
var _glue = null;

function startGlue(){
    if (_glue) clearInterval(_glue);
    _glue = setInterval(function(){
        if (!_active) return;
        var board = findBigBoard();
        if (!board) return;
        if (!board.querySelector('.cd-overlay')){
            paintBoard(_current);
        }
    }, 150);
}

async function runCountdown(){
    _active = true;
    startGlue();

    var seq = [10, 9, 8, 7, 6, 5, 4, 3, 2];
    for (var i = 0; i < seq.length; i++){
        _current = String(seq[i]);
        paintBoard(_current);
        await new Promise(function(r){ setTimeout(r, 850); });
    }
    _current = "LET'S PLAY";
    paintBoard(_current);
    await new Promise(function(r){ setTimeout(r, 1200); });

    _active = false;
    _current = null;
    if (_glue){ clearInterval(_glue); _glue = null; }
    clearBoardOverlay();
}

/* ═══════════════════════════════════════════════════════════
   3. FIRE ONCE PER MATCH — right after user picks delivery
   ═══════════════════════════════════════════════════════════ */
function install(){
    if (window._cdInstalled) return true;
    if (typeof window.showBattingControls !== 'function') return false;
    if (typeof window.showBowlingControls !== 'function') return false;
    window._cdInstalled = true;

    function shouldFire(){
        try {
            return typeof M !== 'undefined' &&
                M.inningsNum === 1 &&
                M.balls === 0 &&
                !M._countdownShown;
        } catch(e){ return false; }
    }

    var _bat = window.showBattingControls;
    window.showBattingControls = async function(){
        var r = await _bat.apply(this, arguments);
        try {
            if (shouldFire()){
                M._countdownShown = true;
                await runCountdown();
            }
        } catch(e){ console.error('[cd/bat]', e); }
        return r;
    };

    var _bowl = window.showBowlingControls;
    window.showBowlingControls = async function(){
        var r = await _bowl.apply(this, arguments);
        try {
            if (shouldFire()){
                M._countdownShown = true;
                await runCountdown();
            }
        } catch(e){ console.error('[cd/bowl]', e); }
        return r;
    };

    if (typeof window.startMatch === 'function' && !window._cdStartHook){
        window._cdStartHook = true;
        var _sm = window.startMatch;
        window.startMatch = function(cfg){
            try { if (typeof M !== 'undefined') M._countdownShown = false; } catch(e){}
            return _sm.apply(this, arguments);
        };
    }

    console.log('%c✅ Countdown on board ACTIVE (v4)', 'color:#00ff88;font-weight:bold;font-size:13px');
    return true;
}

var iv = setInterval(function(){ if (install()) clearInterval(iv); }, 500);
setTimeout(install, 1500);
setTimeout(install, 3000);
setTimeout(install, 5000);

})();
