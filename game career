function sweptCatchCheck(fx, fy, fz, fielder){
  var p = worldToSVG(fx, fy, fz);
  var cur = worldToSVG(B.x, B.y, B.z);
  var sx0 = p.sx, sy0 = p.sy, sx1 = cur.sx, sy1 = cur.sy;
  var segLen = Math.hypot(sx1 - sx0, sy1 - sy0);
  if (segLen < 0.001) return Math.hypot(sx0 - fielder.x, sy0 - fielder.y) < 12;
  var dx = sx1 - sx0, dy = sy1 - sy0;
  var t = clamp(((fielder.x - sx0) * dx + (fielder.y - sy0) * dy) / (segLen * segLen), 0, 1);
  var cx = sx0 + dx * t, cy = sy0 + dy * t;
  return Math.hypot(cx - fielder.x, cy - fielder.y) < 1.6 * PX_PER_M;
}

function tickFielders(fld, dt){
  var land = predictLanding();
  var landSvg = worldToSVG(land.x, land.y, 0);
  var sorted = fld.slice().sort(function(a,b){
    var dA = Math.hypot(a.x - landSvg.sx, a.y - landSvg.sy);
    var dB = Math.hypot(b.x - landSvg.sx, b.y - landSvg.sy);
    return dA - dB;
  });
  var chasers = [sorted[0].id, sorted[1].id];

  for (var i = 0; i < fld.length; i++) {
    var f = fld[i];
    if (chasers.indexOf(f.id) >= 0) {
      var dx = landSvg.sx - f.x, dy = landSvg.sy - f.y;
      var dist = Math.hypot(dx, dy);
      if (dist > 4) {
        var speed = 7 * PX_PER_M * dt;
        var step = Math.min(dist, speed);
        var nx = f.x + (dx / dist) * step;
        var ny = f.y + (dy / dist) * step;
        if (pointInBoundary(nx, ny)) { f.x = nx; f.y = ny; }
        else {
          if (pointInBoundary(nx, f.y)) f.x = nx;
          else if (pointInBoundary(f.x, ny)) f.y = ny;
        }
        place(f.id, f.x, f.y, PLAYER_SCALE, 0);
      }
    }
    if (!f.hasTouched && B.alive && B.vz < 0 && B.z > 0.5 && B.z < 2.6 && !M.freeHit) {
      if (sweptCatchCheck(f.prevX, f.prevY, f.prevZ, f)) {
        f.hasTouched = true;
        var pd = PLAYER_DATA[f.name] || {};
        var catchStat = pd.catch || 65;
        var ballSpeed = Math.hypot(B.vx, B.vy, B.vz);
        var p = clamp((catchStat * 0.85 - ballSpeed * 0.6) / 100 + 0.35, 0.15, 0.95);
        if (Math.random() < p) {
          B.alive = false;
          return { fielder: f.id, name: f.name, caught: true };
        } else {
          B.vx *= 0.4;
          B.vy += (Math.random() - 0.5) * 6;
          B.vz = Math.abs(B.vz) * 0.3 + 1.2;
          addCommentary('Dropped by ' + f.name + '!');
        }
      }
    }
  }
  return null;
}

