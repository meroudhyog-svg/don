    + '<div class="timing-title">TAP ON THE BAR</div>'
    + '<div class="timing-bar" id="timingBar"><div class="timing-sweet"></div><div class="timing-cursor" id="timingCursor"></div></div>'
    + '<div class="timing-feedback" id="timingFeedback">&nbsp;</div>'
    + '<div class="timing-hint">Green zone = perfect timing</div>'
    + '</div>';
  var bar = $('timingBar');
  var cursor = $('timingCursor');
  var fb = $('timingFeedback');
  var pos = 0, dir = 1, alive = true;
  var lastT = performance.now();
  (function tick(now){
    if (!alive) return;
    var dt = Math.min(0.05, (now - lastT) / 1000);
    lastT = now;
    pos += dt * 0.85 * dir;
    if (pos >= 1) { pos = 1; dir = -1; }
    if (pos <= 0) { pos = 0; dir = 1; }
