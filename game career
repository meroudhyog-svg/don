   ═══════════════════════════════════════════════════════════ */
function animateShot(shotType, directionDeg, timing){
  var batData = PLAYER_DATA[M.striker.name] || { power:70, tech:70 };
  var contact = timingToContact(timing);

  var baseSpeed, baseElev;
  if (shotType === 'GROUND') { baseSpeed = 30; baseElev = 8; }
  else { baseSpeed = 27; baseElev = 26; }

  var powerFactor = 0.65 + ((batData.power || 70) / 100) * 0.60;
  var speed = baseSpeed * powerFactor * contact;
  var elevErr = (1 - contact) * (Math.random() - 0.5) * 34;
  var elevRad = (baseElev + elevErr) * Math.PI / 180;
  var dirErr = (1 - contact) * (Math.random() - 0.5) * 50;
  var azDeg = directionDeg + dirErr;
  var azRad = azDeg * Math.PI / 180;
  M._lastShotAngle = azDeg;

  B.x = 0; B.y = 0; B.z = 0.8;
  B.vx = speed * Math.cos(elevRad) * Math.cos(azRad);
  B.vy = -speed * Math.cos(elevRad) * Math.sin(azRad);
  B.vz = speed * Math.sin(elevRad);
  B.alive = true; B.bounces = 0; B.firstBounceX = null; B.peakZ = B.z;

  var startSvg = worldToSVG(B.x, B.y, B.z);
  ballRender.x = startSvg.sx;
  ballRender.y = startSvg.sy;
  ballRender.z = B.z;
  ballRender.opacity = 1;
  renderBall();

  var fld = makeFieldState();
  for (var fi = 0; fi < fld.length; fi++) place(fld[fi].id, fld[fi].x, fld[fi].y, PLAYER_SCALE, 0);

  var caught = false, caughtByName = null, reachedRope = false;
  var last = performance.now();
  var accum = 0, trailTimer = 0;

  return new Promise(function(resolve){
    function frame(now){
      var realDt = Math.min(0.05, (now - last) / 1000);
      last = now;
      accum += realDt;

      while (accum >= SUB_DT && B.alive) {
        for (var a = 0; a < fld.length; a++) {
          fld[a].prevX = B.x; fld[a].prevY = B.y; fld[a].prevZ = B.z;
        }
        stepBall(SUB_DT);
        accum -= SUB_DT;
        var cur = worldToSVG(B.x, B.y, B.z);
        if (!reachedRope && !pointInBoundary(cur.sx, cur.sy)) {
          reachedRope = true;
          B.alive = false;
        }
      }

      if (B.alive) {
        var outcomeCheck = tickFielders(fld, realDt);
        if (outcomeCheck && outcomeCheck.caught) {
          caught = true; caughtByName = outcomeCheck.name;
        }
      }

      trailTimer += realDt;
      if (trailTimer > 0.035 && B.alive) {
        trailTimer = 0;
        var s = worldToSVG(B.x, B.y, B.z);
        pushTrail(s.sx, s.sy);
      }

      var s2 = worldToSVG(B.x, B.y, B.z);
      ballRender.x = s2.sx;
      ballRender.y = s2.sy;
      ballRender.z = B.z;
      renderBall();

      var d = Math.hypot(B.x, B.y);
      var distEl = $('distVal');
      if (distEl) distEl.textContent = Math.round(d);

      if (!B.alive || caught || Math.hypot(B.x, B.y) > 150) {
        setTimeout(function(){
          for (var ff = 0; ff < fld.length; ff++) place(fld[ff].id, fld[ff].homeX, fld[ff].homeY, PLAYER_SCALE, 600);
        }, 500);
        var fadeStart = performance.now();
        var fadeDur = 220;
        (function fade(now2){
          var t = Math.min((now2 - fadeStart) / fadeDur, 1);
          ballRender.opacity = Math.max(0, 1 - t);
          renderBall();
          if (t < 1) requestAnimationFrame(fade);
          else {
            var distM = Math.hypot(B.x, B.y);
            var bounces = B.bounces;
            var runs = 0, kind = 'dot';
            if (caught) { kind = 'caught'; }
            else if (reachedRope) {
              if (bounces === 0) { kind = 'six'; runs = 6; }
              else { kind = 'four'; runs = 4; }
            } else {
              if (distM > 45) runs = 3;
              else if (distM > 25) runs = 2;
              else if (distM > 8) runs = 1;
              else runs = 0;
              kind = runs === 0 ? 'dot' : 'run';
            }
            resolve({ caught: caught, caughtByName: caughtByName, reachedRope: reachedRope, bounces: bounces, distM: distM, runs: runs, kind: kind });
          }
        })(performance.now());
        return;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  });
}

/* ═══════════════════════════════════════════════════════════
   DELIVERY
   ═══════════════════════════════════════════════════════════ */
function makeDeliveryBall(bowler, lengthChoice){
  var d = PLAYER_DATA[bowler.name] || {};
  var pace = d.pace || 65;
  var spin = d.spin || 30;
  var isSpin = spin > pace;
  var speedMs = isSpin ? 22 + (spin/100)*4 : 33 + (pace/100)*8;
  var targetX;
  if (lengthChoice === 'FULL') targetX = 2.5 + Math.random() * 1.5;
  else if (lengthChoice === 'SHORT') targetX = 9 + Math.random() * 2;
  else targetX = 5.5 + Math.random() * 1.5;
  var distance = PITCH_LEN_M - targetX;
  var t = distance / speedMs;
  var releaseZ = 2.05, bounceZ = 0.5;
  var vz = (bounceZ - releaseZ + 0.5 * GRAVITY * t * t) / t;
  var dir = Math.random() < 0.5 ? 1 : -1;
  var swingAccel = 0, turnAccel = 0;
  if (isSpin) { swingAccel = 0.3 + Math.random() * 0.5; turnAccel = 2.5 + (spin/100)*5.5; }
  else { swingAccel = 1.5 + (pace/100)*3.0; turnAccel = 0.3 + Math.random() * 0.8; }
  if (Math.random() < 0.4) { swingAccel *= 0.35; turnAccel *= 0.4; }
  return {
    x: PITCH_LEN_M, y: 0, z: releaseZ,
    vx: -speedMs, vy: 0, vz: vz,
    speedMs: speedMs, isSpin: isSpin,
    swingAccel: swingAccel * dir, turnAccel: turnAccel * dir,
    hasPitched: false, _turnKicked: false
  };
}

function animateDelivery(delivery){
  return new Promise(function(resolve){
    var last = performance.now();
    var accum = 0, simT = 0;
    var LAT = 35;

    function frame(now){
      var realDt = (now - last) / 1000;
      last = now;
      accum += realDt;
      var d = delivery;

      while (accum >= SUB_DT && simT < 0.6) {
        var sp = Math.hypot(d.vx, d.vy, d.vz);
        var ax = 0, ay = 0, az = -GRAVITY;
        if (sp > 0.01) {
          var k = (0.5 * AIR_DENSITY * sp * sp * DRAG_COEFF * BALL_AREA_M) / BALL_MASS_KG;
          ax -= (d.vx / sp) * k;
          ay -= (d.vy / sp) * k;
          az -= (d.vz / sp) * k;
        }
        if (d.hasPitched) ay += d.turnAccel;
        else ay += d.swingAccel;

        d.vx += ax * SUB_DT; d.vy += ay * SUB_DT; d.vz += az * SUB_DT;
        d.x += d.vx * SUB_DT; d.y += d.vy * SUB_DT; d.z += d.vz * SUB_DT;

        if (d.z <= 0 && d.vz < 0) {
          d.z = 0;
          d.vz = -d.vz * BOUNCE_REST_PITCH;
          d.hasPitched = true;
          if (!d._turnKicked) { d._turnKicked = true; d.vy += d.turnAccel * 0.15; }
        }
        simT += SUB_DT;
        accum -= SUB_DT;
        if (d.x <= 0) { simT = 0.6; break; }
      }

      var t01 = 1 - (d.x / PITCH_LEN_M);
      ballRender.x = BOWLER_STUMPS.x + (STRIKER_STUMPS.x - BOWLER_STUMPS.x) * t01 + d.y * LAT;
      ballRender.y = BOWLER_STUMPS.y + (STRIKER_STUMPS.y - BOWLER_STUMPS.y) * t01;
      ballRender.z = d.z;
      ballRender.opacity = 1;
      renderBall();

      if (simT < 0.6 && d.x > 0) requestAnimationFrame(frame);
      else resolve();
    }
    requestAnimationFrame(frame);
  });
}

