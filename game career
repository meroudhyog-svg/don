     ═══════════════════════════════════════════════════════════ -->
<script>
(function(){
'use strict';

/* ═══ 1. BOWLER — stop the "huge after release" bug ═══
   Earlier patch added `transform: none !important` on .releasing
   which overrode the SVG position + scale attribute → sprite
   appeared at 1× scale = giant. Fix: use `revert` + strip class. */
var st = document.createElement('style');
st.textContent = '#bowler.releasing{animation:none !important;transform:revert !important;}';
document.head.appendChild(st);

setInterval(function(){
  var b = document.getElementById('bowler');
  if (b && b.classList.contains('releasing')) b.classList.remove('releasing');
}, 80);

/* Safety — if transform scale ever jumps above expected, reset */
setInterval(function(){
  var b = document.getElementById('bowler');
  if (!b) return;
  var t = b.getAttribute('transform') || '';
  var m = t.match(/scale\(([\d.\-]+)/);
  if (m && Math.abs(parseFloat(m[1])) > 0.08 && !b.classList.contains('walking')){
    b.setAttribute('transform', t.replace(/scale\([^)]+\)/, 'scale(0.055)'));
  }
}, 250);

/* ═══ 2. SILENCE boring ball-by-ball text ═══
   The base game writes "X to bowl", "runs in" etc into the
   LIVE box. We want the real commentary engine to own that box. */

/* ═══ 3. DYNAMIC TEAM CODES + LOGOS in broadcast scoreboard ═══
   The scoreboard HTML has hard-coded IND/AUS. Replace with the
   actual teams playing right now, from M.battingTeam/bowlingTeam. */
function badgeFor(code){
  return (typeof teamBadgeHtml === 'function') ? teamBadgeHtml(code, 16) : code;
}

setInterval(function(){
  var wrap = document.getElementById('bcastBoardWrap');
  if (!wrap || typeof M === 'undefined') return;
  var bt = (typeof getTeam === 'function') ? (getTeam(M.battingTeam) || {}) : {};
  var bw = (typeof getTeam === 'function') ? (getTeam(M.bowlingTeam) || {}) : {};
  var batCode  = bt.code  || M.battingTeam  || 'TEAM';
  var bowlCode = bw.code  || M.bowlingTeam  || 'TEAM';

  /* Replace 3-letter codes */
  var walker = document.createTreeWalker(wrap, NodeFilter.SHOW_TEXT, null, false);
  var nodes = [], n;
  while (n = walker.nextNode()) nodes.push(n);
  nodes.forEach(function(txt){
    var s = txt.nodeValue.trim();
    if (s === 'IND' || s === 'PAK' || s === 'SL' || s === 'NEP') txt.nodeValue = txt.nodeValue.replace(s, batCode);
    else if (s === 'AUS' || s === 'NZ' || s === 'SA' || s === 'ENG') txt.nodeValue = txt.nodeValue.replace(s, bowlCode);
  });

  /* Replace flag emojis with team badge images */
  wrap.querySelectorAll('div').forEach(function(el){
    if (el.children.length !== 0) return;
    var s = el.textContent.trim();
    if (s === '🇮🇳' || s === '🇵🇰' || s === '🇱🇰' || s === '🇳🇵'){
      el.innerHTML = badgeFor(M.battingTeam);
      el.style.fontSize = '0';
    } else if (s === '🇦🇺' || s === '🇳🇿' || s === '🇿🇦' || s === '🏴󠁧󠁢󠁥󠁮󠁧󠁿'){
      el.innerHTML = badgeFor(M.bowlingTeam);
      el.style.fontSize = '0';
    }
  });
}, 700);

/* ═══ 4. INTRO always shows the CURRENT broadcaster ═══
   Reads from localStorage every time intro overlay is open. */
setInterval(function(){
  var ov = document.getElementById('pmiOverlay');
  if (!ov || !ov.classList.contains('show')) return;
  var id = 'star';
  try {
    id = localStorage.getItem('cricket.broadcaster.v3')
      || localStorage.getItem('cricket.broadcaster.v2')
      || 'star';
  } catch(e){}
  var name = id === 'sony' ? 'Sony LIV' : id === 'fox' ? 'Fox Cricket' : 'Star Sports';
  ov.querySelectorAll('.pmi-chip').forEach(function(c){
    if (c.textContent.indexOf('📺') !== -1){
      var want = '📺 ' + name;
      if (c.textContent.trim() !== want) c.textContent = want;
    }
  });
}, 250);

/* ═══ 5. MID-MATCH SCORECARD every 2 overs ═══ */
var lastOver = -1;

function showMMCard(overs){
  var old = document.getElementById('mmCard');
  if (old) old.remove();
  if (typeof M === 'undefined') return;

  var bt = (typeof getTeam === 'function') ? (getTeam(M.battingTeam) || {}) : {};
  var bw = (typeof getTeam === 'function') ? (getTeam(M.bowlingTeam) || {}) : {};

  function photoHtml(name){
    var url = (typeof getPhoto === 'function') ? getPhoto(name) : null;
    var ini = (typeof initialsOf === 'function') ? initialsOf(name) : '?';
    if (url) return '<img src="' + url + '" style="width:100%;height:100%;object-fit:cover;object-position:center top" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\'"><div style="display:none;width:100%;height:100%;align-items:center;justify-content:center;color:#4db8ff;font-family:Anton;font-size:10px">' + ini + '</div>';
    return '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#4db8ff;font-family:Anton;font-size:10px">' + ini + '</div>';
  }

  var batRows = (M.batCard || []).slice(0, 6).map(function(b){
    var isOut = b.out;
    var isActive = (M.striker && M.striker.name === b.name) || (M.nonStriker && M.nonStriker.name === b.name);
    var sr = b.balls > 0 ? ((b.runs / b.balls) * 100).toFixed(0) : '0';
    return '<div style="display:flex;align-items:center;gap:6px;padding:5px 7px;border-radius:6px;background:' + (isActive ? 'rgba(255,204,0,.15)' : 'rgba(0,0,0,.35)') + ';border:1px solid ' + (isActive ? 'rgba(255,204,0,.5)' : 'rgba(255,255,255,.06)') + ';margin-bottom:3px;' + (isOut ? 'opacity:.5;' : '') + '">' +
      '<div style="width:28px;height:28px;border-radius:50%;overflow:hidden;background:#000;border:1.5px solid rgba(255,204,0,.5);flex-shrink:0">' + photoHtml(b.name) + '</div>' +
      '<div style="flex:1;min-width:0"><div style="font-family:Anton;font-size:10px;color:#fff;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + b.name + '</div>' +
      '<div style="font-size:8px;color:#8fa0b8;font-weight:700">SR ' + sr + '</div></div>' +
      '<div style="font-family:Anton;font-size:12px;color:#ffcc00">' + b.runs + ' <span style="font-size:9px;color:#8fa0b8">(' + b.balls + ')</span></div>' +
    '</div>';
  }).join('');

  var bowlRows = (M.bowlCard || []).slice(0, 6).map(function(b){
    var isActive = M.currentBowler && M.currentBowler.name === b.name;
    var ovv = Math.floor((b.balls||0)/6) + '.' + ((b.balls||0)%6);
    var econ = b.balls > 0 ? ((b.runs||0) / (b.balls/6)).toFixed(1) : '0.0';
    return '<div style="display:flex;align-items:center;gap:6px;padding:5px 7px;border-radius:6px;background:' + (isActive ? 'rgba(77,184,255,.15)' : 'rgba(0,0,0,.35)') + ';border:1px solid ' + (isActive ? 'rgba(77,184,255,.5)' : 'rgba(255,255,255,.06)') + ';margin-bottom:3px">' +
      '<div style="width:28px;height:28px;border-radius:50%;overflow:hidden;background:#000;border:1.5px solid rgba(77,184,255,.5);flex-shrink:0">' + photoHtml(b.name) + '</div>' +
      '<div style="flex:1;min-width:0"><div style="font-family:Anton;font-size:10px;color:#fff;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' + b.name + '</div>' +
      '<div style="font-size:8px;color:#8fa0b8;font-weight:700">ECON ' + econ + '</div></div>' +
      '<div style="font-family:Anton;font-size:12px;color:#4db8ff">' + (b.wickets||0) + '-' + (b.runs||0) + ' <span style="font-size:9px;color:#8fa0b8">(' + ovv + ')</span></div>' +
    '</div>';
  }).join('');

  var card = document.createElement('div');
  card.id = 'mmCard';
  card.style.cssText = 'position:fixed;inset:0;z-index:99990;background:rgba(0,0,0,.94);display:flex;align-items:center;justify-content:center;padding:16px';
  card.innerHTML =
    '<div style="width:100%;max-width:700px;max-height:92vh;overflow-y:auto;background:linear-gradient(180deg,#0f1a35,#050810);border:2px solid #ffcc00;border-radius:16px;padding:18px">' +
      '<div style="text-align:center;margin-bottom:12px">' +
        '<div style="font-family:Anton;font-size:10px;letter-spacing:5px;color:#4db8ff">MID-MATCH SCORECARD</div>' +
        '<div style="font-family:Anton;font-size:20px;letter-spacing:3px;color:#ffcc00;margin-top:2px">AFTER ' + overs + ' OVERS</div>' +
      '</div>' +
      '<div style="display:flex;justify-content:center;gap:12px;align-items:center;margin-bottom:14px">' +
        '<div style="text-align:center"><div style="width:48px;height:48px;border-radius:8px;background:#000;border:2px solid rgba(255,204,0,.5);overflow:hidden;margin:0 auto;display:flex;align-items:center;justify-content:center">' + ((typeof teamBadgeHtml==='function')?teamBadgeHtml(M.battingTeam,48):M.battingTeam) + '</div>' +
          '<div style="font-family:Anton;font-size:10px;color:#fff;margin-top:3px">' + (bt.name || M.battingTeam) + '</div></div>' +
        '<div style="font-family:Anton;font-size:22px;color:#ffcc00">' + (M.runs||0) + '-' + (M.wickets||0) + '</div>' +
        '<div style="text-align:center"><div style="width:48px;height:48px;border-radius:8px;background:#000;border:2px solid rgba(255,204,0,.5);overflow:hidden;margin:0 auto;display:flex;align-items:center;justify-content:center">' + ((typeof teamBadgeHtml==='function')?teamBadgeHtml(M.bowlingTeam,48):M.bowlingTeam) + '</div>' +
          '<div style="font-family:Anton;font-size:10px;color:#fff;margin-top:3px">' + (bw.name || M.bowlingTeam) + '</div></div>' +
      '</div>' +
      '<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">' +
        '<div><div style="font-family:Anton;font-size:10px;letter-spacing:2px;color:#ffcc00;margin-bottom:6px">BATTING</div>' + (batRows || '<div style="color:#8fa0b8;font-size:11px">—</div>') + '</div>' +
        '<div><div style="font-family:Anton;font-size:10px;letter-spacing:2px;color:#4db8ff;margin-bottom:6px">BOWLING</div>' + (bowlRows || '<div style="color:#8fa0b8;font-size:11px">—</div>') + '</div>' +
      '</div>' +
      '<button id="mmClose" style="width:100%;margin-top:12px;padding:10px;border:none;border-radius:8px;background:linear-gradient(160deg,#ffcc00,#d4af37);color:#0a1428;font-family:Anton;font-size:12px;letter-spacing:3px;text-transform:uppercase;cursor:pointer">Continue</button>' +
    '</div>';
  document.body.appendChild(card);
  card.querySelector('#mmClose').onclick = function(){ card.remove(); };
  setTimeout(function(){ if (document.getElementById('mmCard') === card) card.remove(); }, 6000);
}

setInterval(function(){
  if (typeof M === 'undefined' || M.phase !== 'play') return;
  var overs = Math.floor((M.balls||0) / 6);
  if (overs > 0 && overs % 2 === 0 && overs !== lastOver){
    lastOver = overs;
    showMMCard(overs);
  }
}, 500);

console.log('%c✅ Bug fixes: bowler · dynamic teams · intro channel · mid-match scorecard',
  'color:#00ff88;font-weight:bold;font-size:13px');
})();
