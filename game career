function pointInBoundary(sx, sy){
  var inside = false;
  for (var i = 0, j = BOUNDARY_POLY.length - 1; i < BOUNDARY_POLY.length; j = i++) {
    var xi = BOUNDARY_POLY[i].x, yi = BOUNDARY_POLY[i].y;
    var xj = BOUNDARY_POLY[j].x, yj = BOUNDARY_POLY[j].y;
    var hit = ((yi > sy) !== (yj > sy)) && (sx < (xj - xi) * (sy - yi) / (yj - yi) + xi);
    if (hit) inside = !inside;
  }
  return inside;
}

function predictLanding(){
  var px = B.x, py = B.y, pz = B.z;
  var vx = B.vx, vy = B.vy, vz = B.vz;
  var dt = 0.01;
  var maxIter = 500;
  while (maxIter-- > 0) {
    var sp = Math.hypot(vx, vy, vz);
    var ax = 0, ay = 0, az = -GRAVITY;
    if (sp > 0.01) {
      var k = (0.5 * AIR_DENSITY * sp * sp * DRAG_COEFF * BALL_AREA_M) / BALL_MASS_KG;
      ax -= (vx / sp) * k; ay -= (vy / sp) * k; az -= (vz / sp) * k;
    }
    vx += ax * dt; vy += ay * dt; vz += az * dt;
    px += vx * dt; py += vy * dt; pz += vz * dt;
    if (pz <= 0) return { x: px, y: py };
  }
  return { x: px, y: py };
}

function stepBall(dt){
  if (!B.alive) return;
  var sp = Math.hypot(B.vx, B.vy, B.vz);
  var ax = 0, ay = 0, az = -GRAVITY;
  if (sp > 0.01) {
    var k = (0.5 * AIR_DENSITY * sp * sp * DRAG_COEFF * BALL_AREA_M) / BALL_MASS_KG;
    ax -= (B.vx / sp) * k; ay -= (B.vy / sp) * k; az -= (B.vz / sp) * k;
  }
  B.vx += ax * dt; B.vy += ay * dt; B.vz += az * dt;
  B.x += B.vx * dt; B.y += B.vy * dt; B.z += B.vz * dt;

  if (B.z <= 0 && B.vz < 0) {
    B.z = 0;
    if (B.firstBounceX === null) B.firstBounceX = B.x;
    var onPitch = (B.x >= 0 && B.x <= PITCH_LEN_M);
    var rest = onPitch ? BOUNCE_REST_PITCH : BOUNCE_REST_GROUND;
    B.vz = -B.vz * rest;
    B.vx *= 0.85; B.vy *= 0.85;
    B.bounces++;
    if (Math.abs(B.vz) < 0.6) B.vz = 0;
  }

  if (B.z <= 0.001 && Math.abs(B.vz) < 0.1) {
    B.z = 0; B.vz = 0;
    var sp2 = Math.hypot(B.vx, B.vy);
    if (sp2 > 0.01) {
      var decel = ROLL_DECEL_MS2 * dt;
      var newSp = Math.max(0, sp2 - decel);
      B.vx = (B.vx / sp2) * newSp;
      B.vy = (B.vy / sp2) * newSp;
    }
    if (sp2 < 0.4) { B.vx = 0; B.vy = 0; B.alive = false; }
  }
  if (B.z > B.peakZ) B.peakZ = B.z;
}

