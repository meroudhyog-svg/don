  'Ravi Shastri':     'https://i.ibb.co/PGXvjvRN/A-4-0-Win-Will-Have-An-Impact-Against-Australia-In-WTC-Final-Ravi-Shastri-Obizworld.png',
  'Sunil Gavaskar':   'https://i.ibb.co/jvJq8KRN/That-s-Where-Bazball-Stops-Sunil-Gavaskar-Says-England-Not-Doing-Anything-Different-With-T.png',
  'Nasser Hussain':   'https://i.ibb.co/bgcLQv5J/India-are-favourites-but-they-re-not-clear-favourites-to-win-ODI-World-Cup-2023-Nasser-Hussa.png',
  'Michael Atherton': 'https://i.ibb.co/23CGWbqc/Atherton-slams-asleep-at-the-wheel-cricket.png',
  'Mark Nicholas':    'https://i.ibb.co/F411JHCY/The-Hundred-set-for-enormous-boost-after-ECB.png',
  'Simon Doull':      'https://i.ibb.co/svQXh5dP/Simon-Doull-respalda-su-controvertida-declaraci-n-sobre-Mohammad-Rizwan-Noticias-Mundo-DIgita.png',
  'Adam Gilchrist':   'https://i.ibb.co/PZBxBZfZ/Gilly-fires-off-at-cricket-mess.png',
  'Shane Warne':      'https://i.ibb.co/8LG3pg4F/Shane-Warne-Net-Worth-Celebrity-Net-Worth.png',
  'Ricky Ponting':    'https://i.ibb.co/v6PSRCcL/Ponting-to-play-on-in-Test-cricket.png',
  'Kumar Sangakkara': 'https://i.ibb.co/G480gwyp/Kumar-sanagakara.png',
  'Wasim Akram':      'https://i.ibb.co/1JL3YKCB/779263541785484230.png'
};

var CACHE_KEY = 'cricket.comm.bodies.v1';
var BODIES = {};

// Restore already-processed bodies
try {
  var cached = JSON.parse(localStorage.getItem(CACHE_KEY) || '{}');
  for (var k in cached) BODIES[k] = cached[k];
} catch(e){}

function saveCache(){
  try { localStorage.setItem(CACHE_KEY, JSON.stringify(BODIES)); } catch(e){}
}

// Process each photo once, remove background
async function processAll(){
  if (!window.imgly || !window.imgly.removeBackground){
    console.log('AI not ready yet');
    return;
  }
  var names = Object.keys(COMM_PHOTOS);
  var pending = names.filter(function(n){ return !BODIES[n]; });
  if (!pending.length) {
    console.log('✅ All commentator bodies ready');
    return;
  }
  console.log('Processing ' + pending.length + ' photos — first time only');

  var box = document.createElement('div');
  box.style.cssText = 'position:fixed;bottom:16px;right:16px;z-index:99999;' +
    'background:#1a2035;border:2px solid #ffcc00;border-radius:8px;' +
    'padding:10px 16px;color:#ffcc00;font-family:Arial;font-size:12px;' +
    'font-weight:bold;box-shadow:0 8px 24px rgba(0,0,0,.8)';
  box.textContent = 'Removing backgrounds: 0 / ' + pending.length;
  document.body.appendChild(box);

  for (var i = 0; i < pending.length; i++){
    var name = pending[i];
    box.textContent = 'Removing backgrounds: ' + i + ' / ' + pending.length;
    try {
      var blob = await window.imgly.removeBackground(COMM_PHOTOS[name]);
      var dataUrl = await new Promise(function(res){
        var r = new FileReader();
        r.onload = function(){ res(r.result); };
        r.readAsDataURL(blob);
      });
      BODIES[name] = dataUrl;
      saveCache();
    } catch(e){
      console.warn('Failed:', name, e);
    }
  }
  box.remove();
  console.log('✅ Done — bodies saved. Reload once to see them.');
}

// The panel — no frame, no background, just body
var panel = null;
var current = '';
var timer = null;

function getPanel(){
  if (panel) return panel;
  panel = document.createElement('div');
  panel.id = 'commentatorPanel';
  panel.style.cssText =
    'position:fixed;bottom:14px;left:14px;z-index:9990;width:150px;' +
    'display:flex;flex-direction:column;align-items:center;gap:6px;' +
    'pointer-events:none;opacity:0;transform:translateY(20px);' +
    'transition:opacity .4s ease,transform .4s ease';
  panel.innerHTML =
    // NO background, NO border, NO frame — just the image
    '<img id="commPhoto" src="" style="' +
      'width:150px;height:180px;object-fit:contain;object-position:center bottom;' +
      'filter:drop-shadow(0 6px 14px rgba(0,0,0,.85)) drop-shadow(0 0 6px rgba(0,0,0,.5));' +
      '">' +
    '<div id="commNameTag" style="' +
      'padding:4px 12px;background:#000;border:1.5px solid #ffcc00;border-radius:6px;' +
      'font-family:Arial;font-size:10px;font-weight:bold;letter-spacing:1px;' +
      'color:#ffcc00;text-transform:uppercase;white-space:nowrap;' +
      'box-shadow:0 4px 10px rgba(0,0,0,.6);"></div>';
  document.body.appendChild(panel);
  return panel;
}

function show(name){
  if (!name) return;
  var src = BODIES[name] || COMM_PHOTOS[name];
  if (!src) return;
  var p = getPanel();
  var img = document.getElementById('commPhoto');
  var tag = document.getElementById('commNameTag');
  if (img.src !== src) img.src = src;
  tag.textContent = name;
  current = name;
  p.style.opacity = '1';
  p.style.transform = 'translateY(0)';
  clearTimeout(timer);
  timer = setTimeout(function(){
    p.style.opacity = '0';
    p.style.transform = 'translateY(20px)';
    current = '';
  }, 7000);
}

// Watch commentary line for names
function watch(){
  var line = document.getElementById('commentaryLine');
  if (!line) return false;
  if (window._cwatch) return true;
  window._cwatch = true;
  new MutationObserver(function(){
    var txt = line.textContent || '';
    for (var n in COMM_PHOTOS){
      if (txt.indexOf(n) !== -1){
        if (n !== current) show(n);
        return;
      }
    }
  }).observe(line, { childList:true, subtree:true, characterData:true });
  return true;
}

// Start everything
window.addEventListener('load', function(){
  setTimeout(processAll, 2500);
  var tries = 0;
  var iv = setInterval(function(){
    tries++;
    if (watch() || tries > 40) clearInterval(iv);
  }, 400);
});

// ─── HIDE PANEL WHEN LEAVING THE FIELD ───
function hidePanel(){
  var p = document.getElementById('commentatorPanel');
  if (p){
    p.style.opacity = '0';
    p.style.transform = 'translateY(20px)';
  }
  current = '';
  clearTimeout(timer);
}

// Watch for field screen becoming inactive
var f = document.getElementById('screen-field');
if (f){
  new MutationObserver(function(){
    if (!f.classList.contains('active')) hidePanel();
  }).observe(f, { attributes:true, attributeFilter:['class'] });
}

// Extra safety — every 500ms, hide if not on field
setInterval(function(){
  var field = document.getElementById('screen-field');
  if (!field || !field.classList.contains('active')){
    var p = document.getElementById('commentatorPanel');
    if (p && parseFloat(getComputedStyle(p).opacity) > 0){
      hidePanel();
    }
  }
}, 500);

})();


</script>
