    'qualifier':["Every match is a final for us. Simple as that."]
  };
  var pool = P[qType] || P['tactics'];
  return pool[Math.floor(Math.random() * pool.length)];
}
function pcCaptainAnswer(qType){
  var P = {
    'player':["I'll back my whole XI. Any one of them can win us this game.","Watch out for our finishers — they've been in unbelievable touch."],
    'knockout':["This is what we live for. Big moments, big players. I'm ready.","The pressure is the privilege. We've been here before."],
    'qualifier':["Momentum matters. Win this one and we move forward with confidence.","Points are gold. We're treating every ball with respect."],
    'form':["I feel good. But it's about the team, not me.","Personally, I'm in a good space. Ready to deliver for the side."]
  };
  var pool = P[qType] || P['player'];
  return pool[Math.floor(Math.random() * pool.length)];
}

/* ─── Overlay ─── */
function pcEnsure(){
  var ov = document.getElementById('pressConfOverlay');
  if (ov) return ov;
  ov = document.createElement('div');
  ov.id = 'pressConfOverlay';
  ov.style.cssText = 'position:fixed;inset:0;z-index:99994;display:none;overflow:hidden;' +
    'font-family:Rajdhani,sans-serif;color:#fff';
  ov.innerHTML =
    '<div style="position:absolute;inset:0;z-index:0;' +
      'background:linear-gradient(180deg,rgba(0,0,0,.15) 0%,rgba(0,0,0,.7) 55%,rgba(0,0,0,.95) 100%),' +
      'url(https://i.ibb.co/svCjmKQt/1113655814097438555.jpg) center/cover no-repeat;"></div>' +
    '<div id="pcSponsorBanner" style="position:absolute;top:0;left:0;right:0;padding:12px 20px;' +
      'background:linear-gradient(180deg,rgba(0,0,0,.85),transparent);' +
      'display:flex;justify-content:space-around;gap:10px;flex-wrap:wrap;z-index:2;opacity:.65"></div>' +
    '<div id="pcStage" style="position:absolute;left:0;right:0;bottom:26%;height:60%;z-index:3">' +
      '<div id="pcCoach" style="position:absolute;bottom:0;left:32%;width:190px;height:250px;' +
        'transform:translateX(-50%) translateX(-350px);opacity:0;' +
        'transition:transform 1.8s cubic-bezier(.4,0,.2,1),opacity 1.2s"></div>' +
      '<div id="pcCaptain" style="position:absolute;bottom:0;left:68%;width:190px;height:250px;' +
        'transform:translateX(-50%) translateX(350px);opacity:0;' +
        'transition:transform 1.8s cubic-bezier(.4,0,.2,1),opacity 1.2s"></div>' +
      '<div style="position:absolute;left:50%;transform:translateX(-50%);bottom:-15px;' +
        'width:70%;max-width:720px;height:110px;' +
        'background:linear-gradient(180deg,#f5f5f5 0%,#e0e0e0 70%,#c8c8c8 100%);' +
        'border-top:6px solid #d8d8d8;border-radius:8px;' +
        'box-shadow:0 -14px 40px rgba(0,0,0,.6),0 22px 44px rgba(0,0,0,.8);z-index:5"></div>' +
      '<div id="pcMics" style="position:absolute;left:50%;transform:translateX(-50%);bottom:90px;' +
        'width:55%;max-width:600px;height:52px;display:flex;justify-content:space-around;' +
        'align-items:flex-end;z-index:6"></div>' +
    '</div>' +
    '<div id="pcTeamHeader" style="position:absolute;top:5%;left:50%;transform:translateX(-50%);' +
      'z-index:7;text-align:center;opacity:0;transition:opacity .8s"></div>' +
    '<div id="pcPanel" style="position:absolute;left:50%;transform:translateX(-50%);bottom:2%;' +
      'width:94%;max-width:780px;z-index:8;display:none"></div>';
  document.body.appendChild(ov);
  return ov;
}
function pcBuildSponsors(){
  var b = document.getElementById('pcSponsorBanner');
  if (!b) return;
  var sp = ['VIVO','DREAM11','TATA','CEAT','MRF','STAR SPORTS','PAYTM'];
  b.innerHTML = sp.map(function(s){
    return '<span style="font-family:Anton;font-size:11px;letter-spacing:3px;color:rgba(255,255,255,.6)">' + s + '</span>';
  }).join('');
}
function pcBuildMics(){
  var m = document.getElementById('pcMics');
  if (!m) return;
  m.innerHTML = '';
  var colors = ['#ff3040','#0a8a2c','#0a4a8a','#1a3a8a','#8a1a8a'];
  for (var i = 0; i < 5; i++){
    var c = colors[i % colors.length];
    var el = document.createElement('div');
    el.style.cssText = 'width:22px;display:flex;flex-direction:column;align-items:center;';
    el.innerHTML =
      '<div style="width:14px;height:14px;border-radius:50%;background:' + c + ';' +
      'box-shadow:0 0 10px ' + c + '"></div>' +
      '<div style="width:4px;height:32px;background:#333;margin-top:-2px"></div>' +
      '<div style="width:28px;height:4px;background:#222;border-radius:2px;margin-top:-1px"></div>';
    m.appendChild(el);
  }
}

/* ─── Show one Q&A step ─── */
function pcShowQA(panel, q, role, teamName, onDone){
  var roleLabel = role === 'coach' ? 'COACH' : 'CAPTAIN';
  var roleIcon = role === 'coach' ? '👔' : '🏏';
  var roleColor = role === 'coach' ? '#4db8ff' : '#00ff88';
  var answer = role === 'coach' ? pcCoachAnswer(q.type) : pcCaptainAnswer(q.type);
  panel.innerHTML =
    '<div style="background:linear-gradient(180deg,#0f1a35,#050810);border:2px solid ' + roleColor + ';' +
    'border-radius:16px;padding:16px 20px;box-shadow:0 0 60px ' + roleColor + '70">' +
    '<div style="font-family:Anton;font-size:11px;letter-spacing:4px;color:#a0d4ff;' +
    'text-transform:uppercase;text-align:center">REPORTER → ' + roleLabel + '</div>' +
    '<div style="font-family:Rajdhani;font-weight:700;font-size:14px;color:#fff;margin-top:8px;' +
    'text-align:center;line-height:1.5;padding:0 10px">"' + q.text + '"</div>' +
    '<div style="margin-top:14px;padding:12px 16px;background:rgba(0,0,0,.5);border-radius:10px;' +
    'border:1px solid ' + roleColor + '55">' +
    '<div style="font-family:Anton;font-size:11px;letter-spacing:3px;color:' + roleColor + ';' +
    'margin-bottom:6px">' + roleIcon + ' ' + teamName + ' ' + (role === 'coach' ? 'Head Coach' : 'Captain') + '</div>' +
    '<div style="font-family:Rajdhani;font-weight:700;font-size:15px;color:#fff;line-height:1.55">' +
    '"' + answer + '"</div></div>' +
    '<button id="pcNextBtn" style="width:100%;margin-top:14px;padding:12px;' +
    'background:linear-gradient(160deg,#ffcc00,#d4af37);color:#0a1428;font-family:Anton;font-size:13px;' +
    'letter-spacing:3px;border:none;border-radius:10px;cursor:pointer">' +
    (role === 'coach' ? 'NEXT — CAPTAIN →' : 'CONTINUE →') + '</button></div>';
  panel.querySelector('#pcNextBtn').onclick = function(){ onDone(); };
}

/* ─── Show full conference for one team ─── */
function pcShowTeam(teamCode, oppCode, isUserTeam){
  return new Promise(function(resolve){
    var ov = pcEnsure();
    var team = S.teams[teamCode];
    if (!team){ resolve(); return; }

    pcBuildSponsors();
    pcBuildMics();

    var colorMap = {
      IND:'#1a4fa8',AUS:'#0a6b2c',ENG:'#0a2d6b',PAK:'#0a6b2c',
      NZ:'#0a1428',SA:'#0a6b2c',WI:'#7a1a1a',SL:'#1a3a8a',
      BAN:'#0a4a1a',AFG:'#1a4fa8',NEP:'#a01a1a'
    };
    var teamColor = colorMap[teamCode] || colorMap[team.country] || '#0a3d8f';

    var coachApp = pcAppearance(team.country || 'default', true);
    var capApp = pcAppearance(team.country || 'default', false);
    capApp.capColor = teamColor;
    var sp = ['VIVO','DREAM11','TATA','CEAT','MRF'][Math.floor(Math.random() * 5)];
    var sponsorText = sp;

    var coachEl = document.getElementById('pcCoach');
    var capEl = document.getElementById('pcCaptain');
    coachEl.innerHTML = pcCharacterSVG(coachApp, teamColor, team.shortName || teamCode, sponsorText);
    capEl.innerHTML = pcCharacterSVG(capApp, teamColor, team.shortName || teamCode, sponsorText);

    var header = document.getElementById('pcTeamHeader');
    var badge = (typeof teamBadgeHtml === 'function') ? teamBadgeHtml(teamCode, 64) : teamCode;
    header.innerHTML =
      '<div style="font-family:Anton;font-size:11px;letter-spacing:5px;color:#ffcc00;text-transform:uppercase">' +
        (isUserTeam ? 'YOUR TEAM — PRESS CONFERENCE' : 'OPPONENT — PRESS CONFERENCE') + '</div>' +
      '<div style="display:flex;align-items:center;justify-content:center;gap:12px;margin-top:8px">' +
        '<div style="width:56px;height:56px;border-radius:10px;background:#000;border:2px solid rgba(255,204,0,.5);' +
          'overflow:hidden;display:flex;align-items:center;justify-content:center">' + badge + '</div>' +
        '<div style="font-family:Anton;font-size:22px;color:#fff;letter-spacing:3px;text-transform:uppercase">' +
          team.name + '</div>' +
      '</div>' +
      '<div style="font-size:11px;letter-spacing:3px;color:#a0d4ff;margin-top:4px;text-transform:uppercase;font-weight:700">' +
        'Coach & Captain</div>';

    ov.style.display = 'block';
    header.style.opacity = '1';
    coachEl.style.transform = 'translateX(-50%) translateX(-350px)';
    coachEl.style.opacity = '0';
    capEl.style.transform = 'translateX(-50%) translateX(350px)';
    capEl.style.opacity = '0';

    /* Walk in */
    setTimeout(function(){
      coachEl.style.transform = 'translateX(-50%) translateX(0)';
      coachEl.style.opacity = '1';
      capEl.style.transform = 'translateX(-50%) translateX(0)';
      capEl.style.opacity = '1';
    }, 200);

    /* After walk-in, show coach Q then captain Q */
    setTimeout(function(){
      var panel = document.getElementById('pcPanel');
      panel.style.display = 'block';
      var coachQ = pickCoachQuestion(teamCode, oppCode);
      pcShowQA(panel, coachQ, 'coach', team.name, function(){
        var capQ = pickCaptainQuestion(teamCode, oppCode);
        pcShowQA(panel, capQ, 'captain', team.name, function(){
          /* walk out */
          coachEl.style.opacity = '0';
          capEl.style.opacity = '0';
          header.style.opacity = '0';
          panel.style.display = 'none';
          setTimeout(function(){
            ov.style.display = 'none';
            resolve();
          }, 700);
        });
      });
    }, 2200);
  });
}

/* ─── Install hook on showToss (once) ─── */
(function(){
  function install(){
    if (window._fpV3PressDone) return true;
    if (typeof window.showToss !== 'function') return false;
    window._fpV3PressDone = true;
    var _toss = window.showToss;
    window.showToss = async function(teamA, teamB){
      try {
        if (typeof S !== 'undefined' && S.teams){
          await pcShowTeam(teamA, teamB, true);
          await new Promise(function(r){ setTimeout(r, 500); });
          await pcShowTeam(teamB, teamA, false);
          await new Promise(function(r){ setTimeout(r, 500); });
        }
      } catch(e){ console.error('[fpV3 press]', e); }
      return _toss.apply(this, arguments);
    };
    console.log('%c✅ Press conference hooked (v3 — single install)', 'color:#00ff88;font-weight:bold;font-size:12px');
    return true;
  }
  var iv = setInterval(function(){ if (install()) clearInterval(iv); }, 500);
  setTimeout(install, 1500);
  setTimeout(install, 3000);
  setTimeout(install, 5000);
})();

console.log('%c✅ FEATURES v3 ready', 'color:#00ff88;font-weight:bold;font-size:13px');
})();
</script>
