<script src="https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.5.5/dist/browser.js"></script>
<script>
(function(){
'use strict';

// Your exact imgbb PNG links
var COMM_PHOTOS = {
  'Sanjay Manjrekar': 'https://i.ibb.co/bjg2sLJZ/Sanjay-Manjrekar-Net-Worth-Age-Height-Affairs-Bio-and-More.png',
  'Ian Bishop':       'https://i.ibb.co/20ChtJ9D/Ian-Bishop-hails-the-role-of-the-IPL-for-giving.png',
