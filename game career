function attachStadiumEvents(scr){
  const sheet = scr.querySelector('#stSheet');
  const quickBar = scr.querySelector('#stQuickBar');
  const preview = scr.querySelector('#stPreview');
  const editHint = scr.querySelector('#stEditHint');
  const editToggle = scr.querySelector('#stEditToggle');
  const editor = scr.querySelector('#stEditor');
  const sbWidthRow = scr.querySelector('#sbWidthRow');
  const sbTitleInput = scr.querySelector('#sbTitleInput');
  const editPresetName = scr.querySelector('#stEditPresetName');

  function openSheet(){ controlsOpen = true; sheet.classList.add('open'); quickBar.classList.add('hidden'); }
  function closeSheet(){ controlsOpen = false; sheet.classList.remove('open'); quickBar.classList.remove('hidden'); }
  scr.querySelector('#stExpandBtn').addEventListener('click', openSheet);
  scr.querySelector('#stCollapseBtn').addEventListener('click', closeSheet);

  scr.querySelector('#stBackBtn').addEventListener('click', () => {
    if (previewRenderer) previewRenderer.stop();
    showScreen('screen-menu');
  });

  scr.querySelector('#stSaveBtn').addEventListener('click', () => {
    saveSettings();
    applyToGameField();
    showToast('Saved all banners');
  });

  scr.querySelector('#stResetPosBtn').addEventListener('click', () => {
    const p = SETTINGS.selectedPreset || 'full';
    const bcfg = SETTINGS.banners[p];
    if (bcfg){
      bcfg.groupOffset = { dx:0, dy:0 };
      bcfg.boardOverrides = {};
    }
    syncControls(scr);
    if (previewRenderer) previewRenderer.update();
    saveSettings();
    showToast('Position reset — ' + LABELS[p]);
  });

  scr.querySelector('#stResetBtn').addEventListener('click', () => {
    SETTINGS.banners = JSON.parse(JSON.stringify(PRESET_DEFAULTS));
    SETTINGS.selectedPreset = 'full';
    syncControls(scr);
    if (previewRenderer) previewRenderer.update();
    showToast('All banners reset');
  });

  editToggle.addEventListener('click', () => {
    SETTINGS.editMode = !SETTINGS.editMode;
    editToggle.classList.toggle('active', SETTINGS.editMode);
    preview.classList.toggle('edit-mode', SETTINGS.editMode);
    editHint.classList.toggle('show', SETTINGS.editMode);
    if (!SETTINGS.editMode) closeEditor();
    restartPreview();
  });

  function openEditorFor(presetKey, idx){
    selectedBoardInfo = { preset: presetKey, idx: idx };
    if (previewRenderer) previewRenderer.setSelected(presetKey, idx);
    const ov = previewRenderer.getBoardOverride(presetKey, idx) || {};
    scr.querySelector('#stEdTitle').textContent = LABELS[presetKey] + ' #' + (idx + 1);
    scr.querySelector('#edScaleW').value = ov.scaleW || 1;
    scr.querySelector('#edScaleH').value = ov.scaleH || 1;
    scr.querySelector('#edAngle').value = ov.angle || 0;
    scr.querySelector('#edBend').value = (ov.bend !== undefined) ? ov.bend : SETTINGS.banners[presetKey].bend;
    scr.querySelector('#edValScaleW').textContent = (parseFloat(scr.querySelector('#edScaleW').value)).toFixed(2) + '×';
    scr.querySelector('#edValScaleH').textContent = (parseFloat(scr.querySelector('#edScaleH').value)).toFixed(2) + '×';
    scr.querySelector('#edValAngle').textContent = Math.round(scr.querySelector('#edAngle').value) + '°';
    scr.querySelector('#edValBend').textContent = parseFloat(scr.querySelector('#edBend').value).toFixed(2);
    editor.classList.add('open');
    quickBar.classList.add('hidden');
  }
  function closeEditor(){
    selectedBoardInfo = null;
    if (previewRenderer) previewRenderer.clearSelection();
    editor.classList.remove('open');
    if (!controlsOpen) quickBar.classList.remove('hidden');
  }
  scr.querySelector('#stEdClose').addEventListener('click', closeEditor);

  scr.querySelector('#stEdDelete').addEventListener('click', () => {
    if (!selectedBoardInfo) return;
    previewRenderer.deleteBoard(selectedBoardInfo.preset, selectedBoardInfo.idx);
    saveSettings();
    closeEditor();
    showToast('Board deleted');
  });
  scr.querySelector('#stEdReset').addEventListener('click', () => {
    if (!selectedBoardInfo) return;
    previewRenderer.resetBoard(selectedBoardInfo.preset, selectedBoardInfo.idx);
    saveSettings();
    closeEditor();
    showToast('Board reset');
  });

  const eb = [
    ['edScaleW','scaleW','edValScaleW', v => v.toFixed(2) + '×'],
    ['edScaleH','scaleH','edValScaleH', v => v.toFixed(2) + '×'],
    ['edAngle','angle','edValAngle', v => Math.round(v) + '°'],
    ['edBend','bend','edValBend', v => v.toFixed(2)]
  ];
  eb.forEach(([id, key, valId, fmt]) => {
    const el = scr.querySelector('#' + id);
    const lbl = scr.querySelector('#' + valId);
    el.addEventListener('input', () => {
      const v = parseFloat(el.value);
      if (!selectedBoardInfo) return;
      previewRenderer.setBoardOverride(selectedBoardInfo.preset, selectedBoardInfo.idx, { [key]: v });
      previewRenderer.redrawBoard();
      lbl.textContent = fmt(v);
    });
    el.addEventListener('change', saveSettings);
  });

  /* Banner toggle buttons (both quick bar and sheet) */
  scr.querySelectorAll('[data-toggle-preset]').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.togglePreset;
      const bcfg = SETTINGS.banners[key];
      if (!bcfg) return;
      bcfg.enabled = !bcfg.enabled;
      /* When enabling, make this the selected preset for editing */
      if (bcfg.enabled) SETTINGS.selectedPreset = key;
      syncControls(scr);
      if (previewRenderer) previewRenderer.update();
      saveSettings();
    });
  });

  /* Content toggle chips */
  scr.querySelectorAll('[data-toggle]').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.toggle;
      SETTINGS[key] = !SETTINGS[key];
      btn.classList.toggle('active', SETTINGS[key]);
      if (previewRenderer) previewRenderer.update();
      saveSettings();
    });
  });

  /* Scoreboard chips */
  scr.querySelectorAll('[data-sb]').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sb;
      SETTINGS.sbShow[key] = !SETTINGS.sbShow[key];
      btn.classList.toggle('active', SETTINGS.sbShow[key]);
      if (previewRenderer) previewRenderer.update();
      saveSettings();
    });
  });

  sbTitleInput.addEventListener('input', () => {
    SETTINGS.sbTournamentName = sbTitleInput.value;
    if (previewRenderer) previewRenderer.update();
  });
  sbTitleInput.addEventListener('change', saveSettings);

  /* Per-preset sliders — always apply to SETTINGS.selectedPreset */
  const bindings = [
    ['slCoverage',   'coverage',      'valCoverage',   v => Math.round(v * 100) + '%'],
    ['slStart',      'startFraction', 'valStart',      v => Math.round(v * 100) + '%'],
    ['slHeight',     'height',        'valHeight',     v => v],
    ['slExtraOut',   'extraOutward',  'valExtraOut',   v => v],
    ['slBoardCount', 'boardCount',    'valBoardCount', v => v],
    ['slGap',        'gap',           'valGap',        v => parseFloat(v).toFixed(2)],
    ['slBend',       'bend',          'valBend',       v => parseFloat(v).toFixed(2)],
    ['slSbWidth',    'sbWidth',       'valSbWidth',    v => v]
  ];
  bindings.forEach(([id, key, valId, fmt]) => {
    const el = scr.querySelector('#' + id);
    const lbl = scr.querySelector('#' + valId);
    el.addEventListener('input', () => {
      const v = parseFloat(el.value);
      const p = SETTINGS.selectedPreset || 'full';
      const bcfg = SETTINGS.banners[p];
      if (!bcfg) return;
      if (key === 'gap' || key === 'sbWidth') bcfg[key] = v;
      else if (key === 'coverage' || key === 'startFraction') bcfg[key] = v;
      else bcfg[key] = Math.round(v);
      lbl.textContent = fmt(v);
      if (previewRenderer) previewRenderer.update();
    });
    el.addEventListener('change', saveSettings);
  });

  scr._openEditorFor = openEditorFor;
  scr._closeEditor = closeEditor;
  scr._sbWidthRow = sbWidthRow;
  scr._editPresetName = editPresetName;
}

function restartPreview(){
  const scr = document.getElementById('stadiumScreen');
  const layer = scr.querySelector('#stadiumLedLayer');
  if (previewRenderer) previewRenderer.stop();
  layer.innerHTML = '';
  previewRenderer = createLedRenderer(layer, SETTINGS, {
    draggable: SETTINGS.editMode,
    onDragEnd: () => saveSettings(),
    onSelect: (info) => {
      if (!info) scr._closeEditor();
      else scr._openEditorFor(info.preset, info.idx);
    }
  });
  previewRenderer.start();
}

function syncControls(scr){
  /* Highlight toggle buttons */
  scr.querySelectorAll('[data-toggle-preset]').forEach(b => {
    const k = b.dataset.togglePreset;
    b.classList.toggle('active', !!SETTINGS.banners[k]?.enabled);
  });
  scr.querySelectorAll('[data-toggle]').forEach(b =>
    b.classList.toggle('active', !!SETTINGS[b.dataset.toggle]));
  const sbShow = SETTINGS.sbShow || {};
  scr.querySelectorAll('[data-sb]').forEach(b =>
    b.classList.toggle('active', !!sbShow[b.dataset.sb]));

  /* Fill sliders from selected preset */
  const p = SETTINGS.selectedPreset || 'full';
  const bcfg = SETTINGS.banners[p];
  const map = [
    ['slCoverage','coverage','valCoverage', v => Math.round(v * 100) + '%'],
    ['slStart','startFraction','valStart', v => Math.round(v * 100) + '%'],
    ['slHeight','height','valHeight', v => v],
    ['slExtraOut','extraOutward','valExtraOut', v => v],
    ['slBoardCount','boardCount','valBoardCount', v => v],
    ['slGap','gap','valGap', v => parseFloat(v).toFixed(2)],
    ['slBend','bend','valBend', v => parseFloat(v).toFixed(2)],
    ['slSbWidth','sbWidth','valSbWidth', v => v]
  ];
  map.forEach(([id, key, valId, fmt]) => {
    const el = scr.querySelector('#' + id), lbl = scr.querySelector('#' + valId);
    if (el && bcfg && bcfg[key] !== undefined){ el.value = bcfg[key]; lbl.textContent = fmt(bcfg[key]); }
  });

  const isSb = bcfg && bcfg.bannerStyle === 'scoreboard';
  const sbW = scr.querySelector('#sbWidthRow');
  if (sbW) sbW.style.display = isSb ? 'flex' : 'none';
  const ti = scr.querySelector('#sbTitleInput');
  if (ti) ti.value = SETTINGS.sbTournamentName || '';

  const ep = scr.querySelector('#stEditPresetName');
  if (ep) ep.textContent = LABELS[p] || p;

  const et = scr.querySelector('#stEditToggle');
  if (et) et.classList.toggle('active', SETTINGS.editMode);
  const prev = scr.querySelector('#stPreview');
  if (prev) prev.classList.toggle('edit-mode', SETTINGS.editMode);
  const hint = scr.querySelector('#stEditHint');
  if (hint) hint.classList.toggle('show', SETTINGS.editMode);
}

function openStadiumScreen(){
  buildStadiumScreen();
  const scr = document.getElementById('stadiumScreen');
  syncControls(scr);
  showScreen('stadiumScreen');
  restartPreview();
  controlsOpen = false;
  scr.querySelector('#stSheet').classList.remove('open');
  scr.querySelector('#stQuickBar').classList.remove('hidden');
}

function showScreen(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const t = document.getElementById(id);
  if (t) t.classList.add('active');
}

/* ─── Apply to game field ─── */
let fieldRenderer = null;

function applyToGameField(){
  const fieldSvg = document.getElementById('field');
  if (!fieldSvg) return;

  if (!fieldSvg.querySelector('#ledDots')){
    const defs = fieldSvg.querySelector('defs');
    if (defs){
      defs.innerHTML += `
        <filter id="ledGlow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="2.5" result="b"/>
          <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <pattern id="ledDots" x="0" y="0" width="3" height="3" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="0.5" fill="rgba(255,255,255,.22)"/>
        </pattern>`;
    }
  }

  let layer = document.getElementById('gameLedLayer');
  if (!layer){
    layer = svgEl('g', { id:'gameLedLayer' });
    const ball = fieldSvg.querySelector('#ball');
    if (ball) fieldSvg.insertBefore(layer, ball);
    else fieldSvg.appendChild(layer);
  }

  if (!SETTINGS.enabled){
    layer.innerHTML = '';
    if (fieldRenderer){ fieldRenderer.stop(); fieldRenderer = null; }
    return;
  }

  if (fieldRenderer) fieldRenderer.stop();
  layer.innerHTML = '';
  fieldRenderer = createLedRenderer(layer, SETTINGS, { draggable: false });
  fieldRenderer.start();
}

window.__stadium = { SETTINGS, applyToGameField, openStadiumScreen, saveSettings };

function boot(){
  addMenuButton();
  setTimeout(applyToGameField, 500);
  const obs = new MutationObserver(() => {
    const field = document.getElementById('screen-field');
    if (field && field.classList.contains('active') && !fieldRenderer) applyToGameField();
  });
  const field = document.getElementById('screen-field');
  if (field) obs.observe(field, { attributes:true, attributeFilter:['class'] });
  console.log('%c✅ STADIUM V10 ACTIVE — multi-banner support',
    'color:#4db8ff;font-weight:bold;font-size:13px');
}

if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
else boot();

function showToast(msg){
  let t = document.getElementById('toast');
  if (t){
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._to);
    t._to = setTimeout(() => t.classList.remove('show'), 2400);
  }
}

})();
</script>



