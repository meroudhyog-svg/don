function computePerimeter(){
  let per = 0; const segs = [];
  for (let i = 0; i < BOUNDARY_POLY.length; i++){
    const a = BOUNDARY_POLY[i], b = BOUNDARY_POLY[(i + 1) % BOUNDARY_POLY.length];
