function showToss(teamA, teamB){
  return new Promise(function(resolve){
    var ov = $('tossOverlay');
    var coin = $('tossCoin');
    var resultEl = $('tossResult');
    var subEl = $('tossSub');
    var buttons = $('tossButtons');
    var user = M.userCode;

    $('tossTeams').textContent = getTeam(teamA).name + ' v ' + getTeam(teamB).name;
    resultEl.textContent = '';
    subEl.textContent = '';
    buttons.classList.remove('show');
    coin.classList.remove('spinning');
    void coin.offsetWidth;
    ov.classList.add('show');

    setTimeout(function(){
      coin.classList.add('spinning');
      setTimeout(function(){
        var userWins = Math.random() < 0.5;
        var winnerCode = userWins ? user : (user === teamA ? teamB : teamA);
        var winnerName = getTeam(winnerCode).name;
        resultEl.textContent = winnerName.toUpperCase() + ' WON THE TOSS';

        if (userWins) {
          subEl.textContent = 'Choose to bat or bowl';
          buttons.classList.add('show');
          var handler = function(e){
            var btn = e.target.closest('.toss-btn');
            if (!btn) return;
            buttons.removeEventListener('click', handler);
            var chose = btn.dataset.toss;
            var finalBat, finalBowl;
            if (chose === 'bat') { finalBat = user; finalBowl = user === teamA ? teamB : teamA; }
            else { finalBowl = user; finalBat = user === teamA ? teamB : teamA; }
            setTimeout(function(){
              ov.classList.remove('show');
              resolve({ battingTeam: finalBat, bowlingTeam: finalBowl });
            }, 600);
          };
          buttons.addEventListener('click', handler);
        } else {
          var aiBat = Math.random() < 0.6;
          subEl.textContent = winnerName + ' chose to ' + (aiBat ? 'bat' : 'bowl') + ' first';
          var finalBat2, finalBowl2;
          if (aiBat) { finalBat2 = winnerCode; finalBowl2 = winnerCode === teamA ? teamB : teamA; }
          else { finalBowl2 = winnerCode; finalBat2 = winnerCode === teamA ? teamB : teamA; }
          setTimeout(function(){
            ov.classList.remove('show');
            resolve({ battingTeam: finalBat2, bowlingTeam: finalBowl2 });
          }, 1500);
        }
      }, 1400);
    }, 200);
  });
}

