  return '$' + n;
};
var initialsOf = function(n){
  if (!n) return '?';
  var parts = n.split(' ');
  var s = '';
  for (var i = 0; i < parts.length && i < 2; i++) s += parts[i].charAt(0);
  return s.toUpperCase();
};

