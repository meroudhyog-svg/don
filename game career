function generateSquadForTeam(team, country, size){
  var squad = [];
  var roles = ['WK','BAT','BAT','BAT','BAT','AR','AR','BOWL','BOWL','BOWL','BOWL'];
  while (roles.length < size) roles.push(pick(['BAT','AR','BOWL','WK']));
  var used = {};
  for (var i = 0; i < roles.length; i++) {
    var role = roles[i];
    var name, guard = 0;
    do { name = generatePlayerName(country); guard++; }
    while (used[name] && guard < 30);
    used[name] = true;
    var base = randInt(58, 82);
    var attrs = makeRandomPlayerAttrs(role, base);
    var p = {
      id: uid('P'),
      name: name,
      role: role,
      country: country,
      age: randInt(19, 34),
      skill: base,
      morale: randInt(65, 90),
      form: randInt(2, 5),
      fatigue: 0,
      injury: null,
      contractYears: randInt(1, 4),
      wage: Math.round((base - 40) * 2400 + randInt(0, 10000)),
      marketValue: Math.round((base - 40) * 55000 + randInt(0, 150000)),
      teamId: team.id,
      trainingFocus: 'balanced',
      season: { M:0, R:0, W:0, C:0 },
      career: { M:0, R:0, W:0, C:0 }
    };
    for (var k in attrs) p[k] = attrs[k];
    S.players[p.id] = p;
    squad.push(p);
  }
  return squad;
}

function newCareer(userTeamCode){
  S.version = 4;
  S.season = 1;
  S.phase = 'preseason';
  S.teams = {};
  S.players = {};
  S.fixtures = [];
  S.news = [];
  S.freeAgents = [];
  S.userXI = [];
  S.champState = null;

  for (var i = 0; i < CLUBS.length; i++) {
    var c = CLUBS[i];
    var code = c[0], name = c[1], league = c[2], country = c[3];
    var team = {
      id: code, code: code, name: name, shortName: code,
      league: league, country: country,
      isUser: code === userTeamCode,
      squad: [],
      rating: { bat: 70, bowl: 70, ovr: 70 },
      season: { P:0, W:0, L:0, Pts:0 },
      eliminated: false,
      champion: false
    };
    var squad = generateSquadForTeam(team, country, 15);
    for (var j = 0; j < squad.length; j++) team.squad.push(squad[j].id);
    var sum = 0;
    for (var k = 0; k < squad.length; k++) sum += squad[k].skill;
    team.rating.ovr = Math.round(sum / squad.length);
    S.teams[code] = team;
  }

  /* Free agents from real players */
  var allNames = Object.keys(PLAYER_DATA);
  for (var m = 0; m < allNames.length; m++) {
    var nm = allNames[m];
    var at = PLAYER_DATA[nm];
    var fa = {
      id: uid('FA'),
      name: nm,
      role: roleOf(nm),
      country: 'INT',
      age: randInt(22, 32),
      skill: ovrOf(nm),
      morale: 80,
      form: 3,
      fatigue: 0,
      injury: null,
      contractYears: 3,
      wage: randInt(8000, 40000),
      marketValue: Math.round((ovrOf(nm) - 40) * 70000 + randInt(0, 200000)),
      teamId: null,
      trainingFocus: 'balanced',
      season: { M:0, R:0, W:0, C:0 },
      career: { M:0, R:0, W:0, C:0 }
    };
    for (var kk in at) fa[kk] = at[kk];
    S.players[fa.id] = fa;
    S.freeAgents.push(fa.id);
  }

  S.userTeamId = userTeamCode;
  addNews('Career started at ' + S.teams[userTeamCode].name + '!', 'welcome');
  addNews(S.freeAgents.length + ' internationals on the market', 'info');
  S.userXI = autoPickXI(userTeamCode);
  save();
}

function autoPickXI(teamId){
  var team = S.teams[teamId];
  if (!team) return [];
  var squad = team.squad.map(function(pid){ return S.players[pid]; });
  var picked = [];
  var need = { WK:1, BAT:4, AR:2, BOWL:4 };
  var sorted = squad.slice().sort(function(a,b){ return b.skill - a.skill; });
  for (var role in need) {
    var count = need[role];
    var avail = sorted.filter(function(p){ return p.role === role && picked.indexOf(p) < 0; });
    for (var i = 0; i < count && i < avail.length; i++) picked.push(avail[i]);
  }
  for (var j = 0; j < sorted.length; j++) {
    if (picked.length >= 11) break;
    if (picked.indexOf(sorted[j]) < 0) picked.push(sorted[j]);
  }
  return picked.map(function(p){ return p.id; });
}

function save(){
  try { localStorage.setItem(SAVE_KEY, JSON.stringify(S)); } catch(e){}
}
function loadSave(){
  try {
    var raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return false;
    var data = JSON.parse(raw);
    if (data.version !== 4) return false;
    for (var k in data) S[k] = data[k];
    return true;
  } catch(e) { return false; }
}
function clearSave(){
  try { localStorage.removeItem(SAVE_KEY); } catch(e){}
}

