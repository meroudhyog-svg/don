    segs.push({ a, b, len, startDist: per });
    per += len;
  }
  return { segs, total: per };
}
function pointAtDistance(segs, dist){
  for (const s of segs){
    if (dist >= s.startDist && dist <= s.startDist + s.len){
      const t = (dist - s.startDist) / s.len;
      return {
        x: s.a.x + (s.b.x - s.a.x) * t,
        y: s.a.y + (s.b.y - s.a.y) * t,
        tangent: Math.atan2(s.b.y - s.a.y, s.b.x - s.a.x)
