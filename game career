  if (!p || !p.active) return;
  if (striker === p.a) { p.aRuns += runs; p.aBalls += ballFaced; }
  else if (striker === p.b) { p.bRuns += runs; p.bBalls += ballFaced; }
  p.total += runs; p.balls += ballFaced;
}
function closePartnership(){
  var p = M.partnerships[M.partnerships.length - 1];
  if (p && p.active) { p.active = false; p.endWkt = M.wickets; }
}

/* ═══════════════════════════════════════════════════════════
   BATTING LOOP
   ═══════════════════════════════════════════════════════════ */
async function bowlBall(){
  if (M.phase === 'done') return;
  M.busy = true;

  var illegalRoll = Math.random();
  if (illegalRoll < 0.02) {
    M.runs += 1;
    if (M.bowlerStats) M.bowlerStats.runs += 1;
    showFeedback('WIDE', 'run');
    setStatus('WIDE · +1 run', true);
    addCommentary('Wide! +1, ball replayed');
    updateHUD();
    await wait(1400);
    M.busy = false;
    return bowlBall();
  }
  if (illegalRoll < 0.035) {
    M.runs += 1;
    if (M.bowlerStats) M.bowlerStats.runs += 1;
    M.freeHit = true;
    showFeedback('NO BALL', 'run');
    setStatus('NO BALL · FREE HIT', true);
    addCommentary('No ball! +1');
    updateHUD();
    await wait(1400);
    M.busy = false;
    return bowlBall();
  }

  if (M.balls > 0 && M.balls % 6 === 0 && M.thisOverBowlerBalls === 0) rotateBowler();

  resetFieldPositions(0);
  showBall(false);
  await wait(200);

  setStatus('Pick your shot');
  addCommentary(M.currentBowler.name + ' to bowl');

  var input = await showBattingControls();
  var shotType = input.type;
  var direction = input.direction;
  var timing = input.timing;
  setHUDVisible(false);

  var strikerTiltEl = document.querySelector('#striker .batting-tilt');
  if (strikerTiltEl) strikerTiltEl.setAttribute('transform', 'rotate(20, 0, -140)');

  setStatus('Bowler running in…');
  addCommentary(M.currentBowler.name + ' runs in…');

  var bdata = PLAYER_DATA[M.currentBowler.name] || {};
  var isSpinner = (bdata.spin||0) > (bdata.pace||0);
  var runStartY = isSpinner ? BOWLER_RELEASE.y + 45 : BOWLER_START.y;
  place('bowler', BOWLER_START.x, runStartY, PLAYER_SCALE, 0, 0);
  await wait(60);
  var runDist = Math.abs(runStartY - BOWLER_RELEASE.y);
  var runDur = isSpinner ? 1400 : Math.round(runDist * 18);
  place('bowler', BOWLER_RELEASE.x, BOWLER_RELEASE.y, PLAYER_SCALE, runDur, 0, 'cubic-bezier(.55, 0, .75, .35)');
  playBatsmanTrigger(runDur);
  await wait(runDur);

  var delivery = makeDeliveryBall(M.currentBowler);
  await animateDelivery(delivery);
  triggerBatSwing();

  var contact = timingToContact(timing);
  var missChance = contact < 0.4 ? 0.55 : (contact < 0.7 ? 0.20 : 0.05);
  var hit = Math.random() > missChance;

  if (!hit) {
    var bowled = Math.random() < 0.30;
    ballRender.opacity = 0; renderBall();
    M.balls++; M.thisOverBowlerBalls++;
    if (M.strikerStats) M.strikerStats.balls++;
    if (M.bowlerStats) M.bowlerStats.balls++;
    if (bowled && !M.freeHit) {
      M.wickets++;
      if (M.bowlerStats) M.bowlerStats.wickets++;
      closePartnership();
      showFeedback('BOWLED!', 'out');
      setStatus('Wicket!', true);
      addCommentary('Bowled! ' + M.currentBowler.name + ' strikes');
      updateHUD();
      await wait(1300);
      return handleWicket();
    }
    showFeedback('DOT BALL', 'dot');
    setStatus('Missed');
    addCommentary('Beaten!');
    updateHUD();
    if (M.freeHit) M.freeHit = false;
    await wait(900);
  } else {
    var result = await animateShot(shotType, direction, timing);
    recordWagonShot(M._lastShotAngle || 0, result.runs, M.striker.name);

    if (result.caught && !M.freeHit) {
      M.wickets++;
      if (M.bowlerStats) M.bowlerStats.wickets++;
      M.balls++; M.thisOverBowlerBalls++;
      if (M.strikerStats) M.strikerStats.balls++;
      if (M.bowlerStats) M.bowlerStats.balls++;
      closePartnership();
      showFeedback('CAUGHT!', 'out');
      setStatus('Caught by ' + result.caughtByName + '!', true);
      addCommentary('Caught by ' + result.caughtByName);
      updateHUD();
      await wait(1300);
      return handleWicket();
    }

    var runs = result.runs;
    M.runs += runs;
    M.balls++; M.thisOverBowlerBalls++;
    if (M.strikerStats) { M.strikerStats.runs += runs; M.strikerStats.balls++; }
    if (M.bowlerStats) { M.bowlerStats.balls++; M.bowlerStats.runs += runs; }
    addToPartnership(M.striker.name, runs, 1);
    if (M.freeHit) M.freeHit = false;

    if (runs > 0 && M.strikerStats) checkBatMilestone(M.strikerStats.runs - runs, M.strikerStats.runs);

    if (runs === 6) { showFeedback('SIX!', 'six'); addCommentary('SIX! ' + Math.round(result.distM) + 'm'); }
    else if (runs === 4) { showFeedback('FOUR!', 'four'); addCommentary('FOUR! ' + Math.round(result.distM) + 'm'); }
    else if (runs === 0) { showFeedback('NO RUN', 'dot'); }
    else { showFeedback(runs + (runs > 1 ? ' RUNS' : ' RUN'), 'run'); }
    updateHUD();
    await wait(1100);

    if (runs % 2 === 1) {
      var tmp = M.striker; M.striker = M.nonStriker; M.nonStriker = tmp;
      var tmp2 = M.strikerStats; M.strikerStats = M.nonStrikerStats; M.nonStrikerStats = tmp2;
    }
  }

  place('bowler', BOWLER_START.x, BOWLER_START.y, PLAYER_SCALE, 500, 0);
  await wait(400);

  M.busy = false;
  setStatus('Ready');

  if (M.balls >= TOTAL_BALLS || M.wickets >= MAX_WICKETS) return endInnings();
  await bowlBall();
}

async function handleWicket(){
  if (M.wickets >= MAX_WICKETS || M.nextBatsmanIdx >= M.battingXI.length) return endInnings();
  var nextIdx = M.nextBatsmanIdx++;
  M.striker = M.battingXI[nextIdx];
  M.strikerStats = M.batCard[nextIdx];
  startNewPartnership(M.nonStriker.name, M.striker.name);
  updateHUD();
  await wait(400);
  M.busy = false;
  await bowlBall();
}

