/* ═══════════════════════════════════════════════════════════
   PROGRESSION / INJURY
   ═══════════════════════════════════════════════════════════ */
function ageModifier(age){
  if (age < 22) return 3.5;
  if (age < 26) return 2.0;
  if (age < 29) return 0.5;
  if (age < 32) return -0.8;
  if (age < 35) return -2.5;
  return -4.0;
}
function runSeasonProgression(){
  var players = Object.values(S.players);
  for (var i = 0; i < players.length; i++) {
    var p = players[i];
    if (p.retired || !p.teamId) continue;
    var mod = ageModifier(p.age);
    p.skill = Math.max(30, Math.min(99, Math.round(p.skill + mod)));
    p.age++;
    p.contractYears = Math.max(0, (p.contractYears || 1) - 1);
    p.season = { M:0, R:0, W:0, C:0 };
    if (p.age >= 40) {
      p.retired = true;
      var team = S.teams[p.teamId];
      if (team) team.squad = team.squad.filter(function(id){ return id !== p.id; });
      p.teamId = null;
      addNews(p.name + ' retires at age ' + p.age, 'info');
    }
  }
}
function applyMatchProgression(result, xiIds){
  if (!result || !xiIds) return;
  for (var i = 0; i < xiIds.length; i++) {
    var p = S.players[xiIds[i]];
    if (!p) continue;
    if (p.season) {
      p.season.M = (p.season.M || 0) + 1;
    }
  }
}
function rollInjury(p){
  if (!p || p.injury) return null;
  var chance = 0.05 * (1 - (p.durability || 60) / 200) * (1 + (p.fatigue || 0) / 150);
  if (Math.random() > chance) return null;
  var r = Math.random() * 100;
  var severity, matchesOut;
  if (r < 50) { severity = 'Minor'; matchesOut = randInt(1, 2); }
  else if (r < 85) { severity = 'Moderate'; matchesOut = randInt(3, 5); }
  else { severity = 'Severe'; matchesOut = randInt(6, 10); }
  var INJURIES = ['Hamstring strain','Side strain','Ankle sprain','Shoulder injury','Knee injury','Back spasm'];
  return { type: pick(INJURIES), severity: severity, matchesOut: matchesOut };
}
function advancePlayerCondition(xiIds){
  var playedSet = {};
  for (var i = 0; i < xiIds.length; i++) playedSet[xiIds[i]] = true;
  var players = Object.values(S.players);
  for (var j = 0; j < players.length; j++) {
    var p = players[j];
    if (p.injury) {
      p.injury.matchesOut = Math.max(0, (p.injury.matchesOut || 0) - 1);
      if (p.injury.matchesOut === 0) {
        addNews(p.name + ' recovered', 'info');
        p.injury = null;
      }
    }
    if (playedSet[p.id]) {
      p.fatigue = Math.min(100, (p.fatigue || 0) + 12);
      var inj = rollInjury(p);
      if (inj) {
        p.injury = inj;
        addNews(p.name + ' injured — ' + inj.type, 'out');
      }
    } else {
      p.fatigue = Math.max(0, (p.fatigue || 0) - 8);
    }
  }
}
function isAvailable(p){
  if (!p) return false;
  if (p.injury) return false;
  if ((p.fatigue || 0) >= 85) return false;
  return true;
}

/* ═══════════════════════════════════════════════════════════
   FIXTURES / SIMULATION
   ═══════════════════════════════════════════════════════════ */
function generateFixtures(){
  var allTeams = Object.keys(S.teams);
  var others = shuffle(allTeams.filter(function(c){ return c !== S.userTeamId; }));
  var newFx = [];
  for (var r = 1; r <= 3; r++) {
    var opp = others[(r - 1) % others.length];
    var userIsHome = r % 2 === 1;
    newFx.push({
      id: 'Q_' + r + '_' + S.userTeamId + '_' + opp,
      round: r, stage: 'qualifier',
      home: userIsHome ? S.userTeamId : opp,
      away: userIsHome ? opp : S.userTeamId,
      played: false, result: null
    });
  }
  S.fixtures = newFx;
}

function simulateMatch(homeId, awayId){
  var h = S.teams[homeId], a = S.teams[awayId];
  var hRating = h.rating.ovr + randInt(-8, 8) + 3;
  var aRating = a.rating.ovr + randInt(-8, 8);
  var diff = hRating - aRating;
  var hScore = Math.max(80, 140 + Math.round(diff * 1.5) + randInt(-25, 25));
  var aScore = Math.max(80, 140 - Math.round(diff * 1.5) + randInt(-25, 25));
  return {
    homeRuns: hScore, homeWkts: randInt(3, 9),
    awayRuns: aScore, awayWkts: randInt(3, 9),
    winner: hScore > aScore ? homeId : (aScore > hScore ? awayId : 'tie')
  };
}

function applyResult(fix){
  if (!fix.result) return;
  var r = fix.result;
  var h = S.teams[fix.home], a = S.teams[fix.away];
  h.season.P++; a.season.P++;
  if (r.winner === fix.home) { h.season.W++; h.season.Pts += 2; a.season.L++; }
  else if (r.winner === fix.away) { a.season.W++; a.season.Pts += 2; h.season.L++; }
  else { h.season.Pts++; a.season.Pts++; }
}

/* ═══════════════════════════════════════════════════════════
   CHAMPIONSHIP
   ═══════════════════════════════════════════════════════════ */
function initChampionship(){
  var ranked = Object.values(S.teams).sort(function(a,b){
    if (b.season.Pts !== a.season.Pts) return b.season.Pts - a.season.Pts;
    if (b.season.W !== a.season.W) return b.season.W - a.season.W;
    return b.rating.ovr - a.rating.ovr;
  });
  var qualified = ranked.slice(0, 32).map(function(t){ return t.id; });
  ranked.slice(32).forEach(function(t){ t.eliminated = true; });
  S.champState = {
    qualified: qualified,
    groups: {},
    groupFixtures: [],
    groupRound: 1,
    maxGroupRounds: 3,
    knockout: { R16: [], QF: [], SF: [], Final: [] },
    knockoutRound: 'R16',
    champion: null
  };
  addNews('Championship initialized', 'welcome');
}

function autoDrawGroups(){
  var CS = S.champState;
  var pool = shuffle(CS.qualified);
  var letters = ['A','B','C','D','E','F','G','H'];
  CS.groups = {};
  for (var i = 0; i < letters.length; i++) CS.groups[letters[i]] = [];
  for (var j = 0; j < pool.length; j++) CS.groups[letters[j % 8]].push(pool[j]);
  generateGroupFixtures();
}

function generateGroupFixtures(){
  var CS = S.champState;
  var fx = [];
  var keys = Object.keys(CS.groups).sort();
  for (var g = 0; g < keys.length; g++) {
    var gname = keys[g];
    var teams = CS.groups[gname];
    if (teams.length < 4) continue;
    var rounds = [[[0,1],[2,3]],[[0,2],[3,1]],[[0,3],[1,2]]];
    for (var ri = 0; ri < rounds.length; ri++) {
      var pairings = rounds[ri];
      for (var pi = 0; pi < pairings.length; pi++) {
        var a = pairings[pi][0], b = pairings[pi][1];
        fx.push({
          id: 'G_' + gname + '_' + ri + '_' + a + b,
          group: gname, round: ri + 1,
          home: teams[a], away: teams[b],
          played: false, result: null
        });
      }
    }
  }
  CS.groupFixtures = fx;
  CS.groupRound = 1;
}

function simGroupRound(){
  var CS = S.champState;
  var round = CS.groupRound;
  var fixs = CS.groupFixtures.filter(function(f){ return f.round === round && !f.played; });
  for (var i = 0; i < fixs.length; i++) {
    fixs[i].result = simulateMatch(fixs[i].home, fixs[i].away);
    fixs[i].played = true;
  }
  CS.groupRound++;
  if (CS.groupRound > CS.maxGroupRounds) finishGroupStage();
}

function finishGroupStage(){
  var CS = S.champState;
  var groupStats = {};
  var groupKeys = Object.keys(CS.groups);
  for (var gi = 0; gi < groupKeys.length; gi++) {
    var g = groupKeys[gi];
    groupStats[g] = {};
    for (var ti = 0; ti < CS.groups[g].length; ti++) {
      groupStats[g][CS.groups[g][ti]] = { P:0, W:0, L:0, Pts:0, RF:0, RA:0 };
    }
    var gfx = CS.groupFixtures.filter(function(f){ return f.group === g && f.played; });
    for (var fi = 0; fi < gfx.length; fi++) {
      var f = gfx[fi];
      var H = groupStats[g][f.home], A = groupStats[g][f.away];
      if (!H || !A) continue;
      H.P++; A.P++;
      H.RF += f.result.homeRuns; H.RA += f.result.awayRuns;
      A.RF += f.result.awayRuns; A.RA += f.result.homeRuns;
      if (f.result.winner === f.home) { H.W++; H.Pts += 2; A.L++; }
      else if (f.result.winner === f.away) { A.W++; A.Pts += 2; H.L++; }
      else { H.Pts++; A.Pts++; }
    }
  }
  var pairs = [['A','B'],['C','D'],['E','F'],['G','H']];
  var r16Fixtures = [];
  for (var pi = 0; pi < pairs.length; pi++) {
    var g1 = pairs[pi][0], g2 = pairs[pi][1];
    if (!groupStats[g1] || !groupStats[g2]) continue;
    var s1 = Object.entries(groupStats[g1]).sort(function(a,b){ return b[1].Pts - a[1].Pts; });
    var s2 = Object.entries(groupStats[g2]).sort(function(a,b){ return b[1].Pts - a[1].Pts; });
    if (!s1[0] || !s1[1] || !s2[0] || !s2[1]) continue;
    r16Fixtures.push({ id:'R16_A' + pi, home:s1[0][0], away:s2[1][0], played:false, result:null });
    r16Fixtures.push({ id:'R16_B' + pi, home:s2[0][0], away:s1[1][0], played:false, result:null });
  }
  CS.knockout.R16 = r16Fixtures;
  CS.knockoutRound = 'R16';
}

function advanceKnockout(){
  var CS = S.champState;
  var nextMap = { R16:'QF', QF:'SF', SF:'Final', Final:null };
  var cur = CS.knockoutRound;
  var curFixtures = CS.knockout[cur] || [];
  if (curFixtures.some(function(f){ return !f.played; })) return;
  var next = nextMap[cur];
  if (!next) {
    var f = curFixtures[0];
    CS.champion = f.result.winner === 'tie' ? f.home : f.result.winner;
    return;
  }
  var winners = curFixtures.map(function(f){ return f.result.winner === 'tie' ? f.home : f.result.winner; });
  var nextFixtures = [];
  for (var i = 0; i < winners.length; i += 2) {
    nextFixtures.push({ id: next + '_' + (i/2+1), home: winners[i], away: winners[i+1], played: false, result: null });
  }
  CS.knockout[next] = nextFixtures;
  CS.knockoutRound = next;
}

