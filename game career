/* ─── Question pools ─── */
function pickCoachQuestion(teamCode, oppCode){
  var uT = S.teams[teamCode], oT = S.teams[oppCode];
  var uP = uT.season.P || 0, uW = uT.season.W || 0;
  var oP = oT.season.P || 0, oW = oT.season.W || 0;
  var pool = [];
  if (uP === 0) pool.push({ text:"This is your opening match of the season. What's the mood in the camp, coach?", type:'opening' });
  else pool.push({ text:"You've played " + uP + " match" + (uP===1?'':'es') + ", won " + uW + ". How has the preparation been?", type:'form' });
  if (oP > 0 && oW >= oP / 2) pool.push({ text:oT.name + " have been in strong form. What's your plan to counter them?", type:'opponent-strong' });
  else if (oP > 0) pool.push({ text:oT.name + " haven't had the best run so far. Do you see this as an opportunity?", type:'opponent-weak' });
  else pool.push({ text:oT.name + " haven't played yet. What do you know about them, and how will you prepare?", type:'opponent-unknown' });
  pool.push({ text:"What's the tactical approach — bat first or bowl first, and why?", type:'tactics' });
  pool.push({ text:"Which areas of your team's game did you focus on during training?", type:'tactics' });
  return pool[Math.floor(Math.random() * pool.length)];
}
function pickCaptainQuestion(teamCode, oppCode){
  var uT = S.teams[teamCode];
  var pool = [
    { text:"From your perspective on the field, what's the key to winning this match?", type:'player' },
    { text:"Which of your teammates do you think will make the biggest impact today?", type:'player' },
