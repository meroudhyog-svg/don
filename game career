<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Cricket Career</title>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{background:#04060c;height:100vh;overflow:hidden;font-family:'Rajdhani',sans-serif;color:#fff;user-select:none}
#app{position:relative;width:100vw;height:100vh;overflow:hidden}
.screen{position:absolute;inset:0;display:none;flex-direction:column}
.screen.active{display:flex}
#screen-menu{background:url('https://i.ibb.co/YBWjBdzZ/Gemini-Generated-Image-x0gciax0gciax0gc.jpg') center/cover no-repeat;align-items:center;justify-content:center;padding:24px;text-align:center;position:relative}
#screen-menu::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,6,12,.55),rgba(4,6,12,.35) 40%,rgba(4,6,12,.85));z-index:0}
#screen-menu > *{position:relative;z-index:1}
.menu-logo{font-size:60px}
.menu-title{font-family:'Anton',sans-serif;font-size:36px;letter-spacing:6px;color:#ffcc00;text-transform:uppercase;text-shadow:0 0 30px rgba(255,204,0,.7);margin-top:6px}
.menu-sub{font-family:'Anton',sans-serif;font-size:11px;letter-spacing:5px;color:#a0d4ff;text-transform:uppercase;margin-top:10px}
.menu-btn{margin-top:32px;padding:18px 52px;border-radius:14px;border:2px solid #fff3b0;background:linear-gradient(160deg,#ffcc00,#d4af37);color:#0a1428;font-family:'Anton',sans-serif;font-size:16px;letter-spacing:3px;text-transform:uppercase;cursor:pointer;box-shadow:0 0 30px rgba(255,204,0,.7)}
.menu-btn:active{transform:scale(.95)}
.menu-info{margin-top:22px;font-size:11px;letter-spacing:2px;color:#a0aec0;font-weight:700;text-transform:uppercase;max-width:340px;line-height:1.7}

#screen-field{background:#04060c;overflow:hidden}
#stadiumImg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;filter:hue-rotate(2deg) saturate(1.35) brightness(1.36)}
.stage{position:absolute;inset:0;z-index:3}
.field-svg{width:100%;height:100%;display:block}
.feedback{position:absolute;top:28%;left:50%;transform:translate(-50%,-50%) scale(0);z-index:20;font-family:'Anton',sans-serif;font-size:52px;letter-spacing:6px;text-transform:uppercase;text-shadow:0 0 40px currentColor,0 6px 24px rgba(0,0,0,.9);pointer-events:none;opacity:0;transition:all .35s cubic-bezier(.2,1.5,.4,1);white-space:nowrap}
.feedback.show{transform:translate(-50%,-50%) scale(1);opacity:1}
.feedback.four{color:#4db8ff}
.feedback.six{color:#ffcc00}
.feedback.out{color:#ff3366}
.feedback.run{color:#00ff88}
.feedback.dot{color:#c0c0c8;font-size:36px}
.ui{position:absolute;z-index:10}
#uiStatus{top:1.5%;left:50%;transform:translateX(-50%);padding:5px 16px;background:linear-gradient(160deg,#1a0a3a,#0a0520);border:1.5px solid #ffcc00;border-radius:16px;font-family:'Anton',sans-serif;font-size:10px;letter-spacing:2.5px;color:#ffcc00;text-transform:uppercase;white-space:nowrap;opacity:.85}
#uiStatus.fire{opacity:1;background:linear-gradient(160deg,#ff6622,#8a1a00);color:#fff}
#uiDist{top:7%;right:4%;padding:5px 12px;background:rgba(0,0,0,.7);border:1.5px solid rgba(255,204,0,.5);border-radius:10px;font-family:'Anton',sans-serif;font-size:9px;letter-spacing:2px;color:#ffcc00;text-transform:uppercase;display:flex;align-items:center;gap:6px;opacity:.85}
#uiDist .dval{font-family:'Anton';font-size:14px;color:#fff}
#uiBack{top:1.8%;left:2.5%;width:42px;height:42px;border-radius:50%;background:rgba(0,0,0,.78);border:2px solid #ff3366;color:#ff3366;font-size:18px;font-weight:900;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:.75;z-index:30}
#uiCommentary{top:6.5%;left:3%;padding:5px 12px;background:rgba(0,0,0,.85);border:1px solid rgba(255,204,0,.4);border-radius:8px;pointer-events:none;max-width:280px}
#uiCommentary .hd{font-family:'Anton',sans-serif;font-size:9px;letter-spacing:3px;color:#ff3366;text-transform:uppercase}
#uiCommentary .line{margin-top:4px;font-size:11px;font-weight:700;color:#d8e0ec}
#uiScore{top:82.9%;left:51.78%;transform:translate(-50%,0) scale(1.2);transform-origin:center top;display:flex;align-items:center;gap:10px;background:linear-gradient(180deg,rgba(10,20,40,.96),rgba(5,10,22,.99));border:1.5px solid #ffcc00;border-radius:10px;padding:6px 14px;height:52px;box-shadow:0 0 24px rgba(0,0,0,.75);white-space:nowrap;z-index:12}
#uiScore .blk{display:flex;align-items:center;gap:8px}
#uiScore .blk:not(:first-child){border-left:1px solid rgba(255,204,0,.25);padding-left:10px}
#uiScore .pic{width:32px;height:32px;border-radius:50%;overflow:hidden;background:#000;border:1.5px solid rgba(255,204,0,.5);flex-shrink:0}
#uiScore .pic img{width:100%;height:100%;object-fit:cover;object-position:center top}
#uiScore .ini{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:'Anton';font-size:11px;color:#4db8ff}
#uiScore .m{display:flex;flex-direction:column;line-height:1.1}
#uiScore .nm{font-family:'Anton',sans-serif;font-size:10px;letter-spacing:.5px;color:#fff;text-transform:uppercase}
#uiScore .st{font-family:'Anton',sans-serif;font-size:11px;color:#ffcc00;margin-top:1px}
#uiScore .st .dim{color:#a0aec0;font-size:9px}
#uiScore .ct{text-align:center;padding:0 14px}
#uiScore .sc{font-family:'Anton',sans-serif;font-size:18px;color:#ffcc00;line-height:1}
#uiScore .ov{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:9px;color:#a0aec0;margin-top:2px}
#uiShot{top:71%;left:51.28%;transform:translate(-50%,0) scale(.64);transform-origin:center top;display:flex;gap:10px;z-index:14}
#uiShot .b{padding:18px 30px;border-radius:14px;border:2px solid;background:linear-gradient(160deg,rgba(20,45,90,.95),rgba(5,15,40,.98));font-family:'Anton',sans-serif;font-size:14px;letter-spacing:2px;text-transform:uppercase;color:#fff;cursor:pointer;min-width:130px}
#uiShot .b:active{transform:scale(.94)}
#uiShot .b.def{border-color:#a0aec0}
#uiShot .b.gnd{border-color:#00ff88;color:#00ff88}
#uiShot .b.lft{border-color:#ffcc00;color:#ffcc00}
#uiShot .b .sub{display:block;font-family:'Rajdhani',sans-serif;font-size:9px;font-weight:700;letter-spacing:1.5px;color:rgba(255,255,255,.5);margin-top:3px}
#uiShot.vertical{flex-direction:column;align-items:center;gap:10px;top:56%}
.direction-dial{position:relative;width:290px;height:290px;background:radial-gradient(circle at 50% 50%,rgba(0,0,0,.55),rgba(0,0,0,.88));border:2px solid rgba(255,204,0,.55);border-radius:50%;box-shadow:0 0 45px rgba(0,0,0,.85)}
.dial-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:64px;height:64px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffdd44,#8a5a00);display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:9px;color:#0a1428;pointer-events:none}
.dial-btn{position:absolute;width:60px;height:60px;border-radius:50%;border:2px solid rgba(77,184,255,.7);background:linear-gradient(160deg,rgba(20,45,90,.95),rgba(5,15,40,.98));color:#ffcc00;font-size:22px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:'Anton',sans-serif}
.dial-btn:active{transform:scale(.9);background:linear-gradient(160deg,#00ff88,#008a48);color:#041008}
.timing-container{padding:16px 20px;background:rgba(0,0,0,.85);border:2px solid rgba(255,204,0,.55);border-radius:14px;min-width:340px}
.timing-title{font-family:'Anton',sans-serif;font-size:12px;letter-spacing:3px;color:#ffcc00;text-align:center;text-transform:uppercase;margin-bottom:10px}
.timing-bar{position:relative;height:44px;background:linear-gradient(90deg,#1a1a1a,#0a0a0a,#1a1a1a);border:1.5px solid rgba(255,255,255,.2);border-radius:10px;overflow:hidden;cursor:pointer}
.timing-sweet{position:absolute;left:43%;width:14%;top:0;bottom:0;background:linear-gradient(90deg,rgba(0,255,136,0),rgba(0,255,136,.75),rgba(0,255,136,0));pointer-events:none}
.timing-cursor{position:absolute;top:-4px;bottom:-4px;width:5px;background:#ffcc00;border-radius:3px;box-shadow:0 0 14px #ffcc00;transform:translateX(-50%);left:0%;pointer-events:none}
.timing-cursor.perfect{background:#00ff88}
.timing-cursor.good{background:#ffcc00}
.timing-cursor.okay{background:#ff8844}
.timing-cursor.poor{background:#ff3366}
.timing-hint{margin-top:10px;font-family:'Anton',sans-serif;font-size:10px;letter-spacing:2.5px;color:#a0d4ff;text-align:center;text-transform:uppercase}
.timing-feedback{margin-top:6px;font-family:'Anton',sans-serif;font-size:16px;letter-spacing:3px;text-align:center;text-transform:uppercase;min-height:20px}
.sprite{transform-origin:0 0}
.sprite.walking .walk-body{animation:walkBob 0.55s ease-in-out infinite alternate}
@keyframes walkBob{from{transform:translateY(0)}to{transform:translateY(-3px)}}
.sprite.walking .walk-leg-front-rot{animation:legFront 0.55s ease-in-out infinite alternate}
.sprite.walking .walk-leg-back-rot{animation:legBack 0.55s ease-in-out infinite alternate}
@keyframes legFront{from{transform:rotate(-22deg)}to{transform:rotate(22deg)}}
@keyframes legBack{from{transform:rotate(22deg)}to{transform:rotate(-22deg)}}
.sprite.walking .walk-arm-front-rot{animation:armFront 0.55s ease-in-out infinite alternate}
.sprite.walking .walk-arm-back-rot{animation:armBack 0.55s ease-in-out infinite alternate}
@keyframes armFront{from{transform:rotate(14deg)}to{transform:rotate(-14deg)}}
@keyframes armBack{from{transform:rotate(-14deg)}to{transform:rotate(14deg)}}
.overlay{position:fixed;inset:0;background:radial-gradient(circle at 50% 40%,#0a1a3d,#000 78%);z-index:5000;display:none;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center}
.overlay.show{display:flex}
.ov-kicker{font-family:'Anton',sans-serif;font-size:11px;letter-spacing:4px;color:#a0d4ff;text-transform:uppercase;margin-bottom:8px}
.ov-title{font-family:'Anton',sans-serif;font-size:34px;letter-spacing:4px;color:#ffcc00;text-transform:uppercase;margin-bottom:6px}
.ov-big{font-family:'Anton',sans-serif;font-size:60px;color:#fff;margin:14px 0}
.ov-sub{font-size:13px;letter-spacing:2px;color:#a0aec0;text-transform:uppercase;font-weight:700;margin-bottom:18px}
.ov-btn{padding:16px 44px;border-radius:14px;border:2px solid #fff3b0;background:linear-gradient(160deg,#ffcc00,#d4af37);color:#0a1428;font-family:'Anton',sans-serif;font-size:14px;letter-spacing:3px;text-transform:uppercase;cursor:pointer}
.toss-overlay{position:fixed;inset:0;z-index:9600;background:radial-gradient(circle at 50% 40%,#1a0a3a,#000 78%);display:none;align-items:center;justify-content:center;padding:20px}
.toss-overlay.show{display:flex}
.toss-card{width:100%;max-width:460px;background:linear-gradient(180deg,#1a1f35,#0a0510);border:2px solid #ffcc00;border-radius:16px;padding:22px 20px;text-align:center}
.toss-kicker{font-family:'Anton',sans-serif;font-size:10px;letter-spacing:4px;color:#a0d4ff;text-transform:uppercase}
.toss-title{font-family:'Anton',sans-serif;font-size:22px;color:#fff;letter-spacing:3px;margin-top:6px;text-transform:uppercase}
.toss-coin{width:110px;height:110px;margin:20px auto;border-radius:50%;background:linear-gradient(160deg,#ffcc00,#d4af37);border:4px solid #8a5a00;display:flex;align-items:center;justify-content:center;font-family:'Anton',sans-serif;font-size:44px;color:#3a1a00}
.toss-coin.spinning{animation:tossSpin 1.4s cubic-bezier(.3,.8,.4,1) forwards}
@keyframes tossSpin{0%{transform:rotateY(0)}50%{transform:rotateY(720deg) rotateX(180deg)}100%{transform:rotateY(1440deg) rotateX(360deg)}}
.toss-result{font-family:'Anton',sans-serif;font-size:22px;color:#ffcc00;letter-spacing:2px;text-transform:uppercase;margin-top:8px;min-height:32px}
.toss-sub{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:13px;letter-spacing:2px;color:#a0d4ff;text-transform:uppercase;margin-top:6px;min-height:18px}
.toss-buttons{display:none;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}
.toss-buttons.show{display:grid}
.toss-btn{padding:16px 12px;border-radius:12px;font-family:'Anton',sans-serif;font-size:14px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;border:none}
.toss-btn.bat{background:linear-gradient(160deg,#00d455,#007a30);color:#fff}
.toss-btn.bowl{background:linear-gradient(160deg,#4db8ff,#0a3a7a);color:#fff}
.milestone-overlay{position:fixed;inset:0;z-index:9700;background:radial-gradient(circle at 50% 40%,rgba(30,10,60,.94),rgba(0,0,0,.96) 70%);display:none;align-items:center;justify-content:center;padding:20px;cursor:pointer}
.milestone-overlay.show{display:flex}
.milestone-card{text-align:center;max-width:360px;width:100%;padding:26px 20px 22px;background:linear-gradient(180deg,rgba(30,50,110,.85),rgba(8,15,35,.95));border:2px solid #ffcc00;border-radius:20px}
.milestone-kicker{font-family:'Anton',sans-serif;font-size:11px;letter-spacing:5px;color:#ffd24a;text-transform:uppercase}
.milestone-name{font-family:'Anton',sans-serif;font-size:24px;letter-spacing:2px;color:#fff;text-transform:uppercase;margin-top:8px}
.milestone-big{font-family:'Anton',sans-serif;font-size:72px;line-height:1;color:#ffcc00;margin:6px 0}
.milestone-sub{font-family:'Rajdhani',sans-serif;font-weight:700;font-size:13px;color:#a0d4ff;letter-spacing:2px;text-transform:uppercase;margin-bottom:14px}
.milestone-stats{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;padding:12px 16px;background:rgba(0,0,0,.4);border-radius:12px;border:1px solid rgba(255,204,0,.25)}
.milestone-stat{display:flex;justify-content:space-between;font-size:11px}
.milestone-stat .lbl{font-weight:600;color:#d8e0ec;text-transform:uppercase}
.milestone-stat .val{font-family:'Anton',sans-serif;font-size:13px;color:#ffcc00}

#careerScreen{position:absolute;inset:0;display:none;flex-direction:column;background:#050a1a;color:#fff;overflow:hidden}
#careerScreen.active{display:flex}
#careerScreen .bg-layer{position:absolute;inset:0;background:url('https://i.ibb.co/4Z4LPbmQ/Shubman-Gill-hd-Wallpaper.jpg') center/cover no-repeat;filter:brightness(.4) saturate(1.15);z-index:0}
#careerScreen .bg-fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,9,18,.6),rgba(4,9,18,.35) 40%,rgba(4,9,18,.9));z-index:0}
.cr-top{padding:14px 20px 10px;text-align:center;flex-shrink:0;border-bottom:1px solid rgba(255,204,0,.2);background:linear-gradient(180deg,rgba(0,0,0,.5),transparent);position:relative;z-index:2}
.cr-kicker{font-family:'Anton',sans-serif;font-size:10px;letter-spacing:5px;color:#ffcc00;text-transform:uppercase}
.cr-title{font-family:'Anton',sans-serif;font-size:24px;letter-spacing:3px;color:#fff;margin-top:2px}
.cr-sub{font-size:11px;letter-spacing:3px;color:#8fc4ff;text-transform:uppercase;font-weight:700;margin-top:4px}
.cr-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:12px 20px;position:relative;z-index:2}
.cr-stat{padding:12px 8px;background:linear-gradient(160deg,rgba(255,204,0,.08),rgba(0,0,0,.5));border:1px solid rgba(255,204,0,.3);border-radius:10px;text-align:center}
.cr-stat .l{font-family:'Anton',sans-serif;font-size:9px;letter-spacing:2px;color:#ffcc00;text-transform:uppercase}
.cr-stat .v{font-family:'Anton',sans-serif;font-size:20px;color:#fff;margin-top:4px;line-height:1}
.cr-tabs{display:flex;gap:2px;padding:0 20px;flex-shrink:0;overflow-x:auto;border-bottom:1px solid rgba(255,255,255,.1);position:relative;z-index:2}
.cr-tab{padding:12px 16px;background:transparent;border:none;border-bottom:3px solid transparent;font-family:'Anton',sans-serif;font-size:10px;letter-spacing:1.5px;color:#7a8fa8;cursor:pointer;text-transform:uppercase;white-space:nowrap}
.cr-tab.active{color:#ffcc00;border-bottom-color:#ffcc00}
.cr-body{flex:1;overflow-y:auto;padding:16px 20px 80px;position:relative;z-index:2}
.cr-card{background:linear-gradient(160deg,rgba(15,30,65,.92),rgba(5,10,25,.95));border:1px solid rgba(255,204,0,.28);border-radius:14px;padding:16px 18px;margin-bottom:12px}
.cr-card-title{font-family:'Anton',sans-serif;font-size:13px;letter-spacing:3px;color:#ffcc00;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:10px}
.cr-card-title::before{content:'';width:4px;height:16px;background:#ffcc00;border-radius:2px}
.cr-row{display:flex;align-items:center;gap:10px;padding:10px 12px;margin-bottom:6px;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.06);border-radius:10px}
.cr-row:active{border-color:rgba(255,204,0,.35)}
.cr-photo{width:44px;height:44px;border-radius:50%;overflow:hidden;background:#000;border:2px solid rgba(255,204,0,.45);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.cr-photo img{width:100%;height:100%;object-fit:cover;object-position:center top}
.cr-photo .ini{font-family:'Anton',sans-serif;font-size:15px;color:#4db8ff;width:100%;height:100%;display:flex;align-items:center;justify-content:center}
.cr-name{font-family:'Anton',sans-serif;font-size:12px;color:#fff;letter-spacing:.5px;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cr-meta{font-size:10px;font-weight:700;color:#7a8fa8;letter-spacing:1px;margin-top:2px}
.cr-role{display:inline-block;padding:2px 7px;border-radius:5px;font-family:'Anton',sans-serif;font-size:9px;letter-spacing:1px;margin-left:6px}
.cr-role.BAT{background:rgba(77,184,255,.2);color:#4db8ff}
.cr-role.BOWL{background:rgba(255,51,102,.2);color:#ff3366}
.cr-role.AR{background:rgba(0,255,136,.2);color:#00ff88}
.cr-role.WK{background:rgba(255,204,0,.2);color:#ffcc00}
.cr-btn{padding:12px 22px;border-radius:10px;border:none;background:linear-gradient(160deg,#ffcc00,#d4af37);color:#0a1428;font-family:'Anton',sans-serif;font-size:12px;letter-spacing:2.5px;text-transform:uppercase;cursor:pointer;transition:.15s;margin-right:8px;margin-bottom:8px}
.cr-btn:active{transform:scale(.96)}
.cr-btn.ghost{background:rgba(0,0,0,.5);border:1.5px solid rgba(255,204,0,.5);color:#ffcc00}
.cr-btn.green{background:linear-gradient(160deg,#00d455,#007a30);color:#fff}
.cr-btn:disabled{opacity:.35}
.cr-empty{text-align:center;padding:40px 20px;color:#7a8fa8;font-style:italic;font-size:12px}
.cr-news{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.92);border-top:1px solid rgba(255,204,0,.3);padding:8px 20px;max-height:60px;overflow:hidden;z-index:3}
.cr-news-t{font-family:'Anton',sans-serif;font-size:10px;letter-spacing:3px;color:#ff3366;text-transform:uppercase;margin-bottom:3px}
.cr-news-line{font-size:11px;font-weight:600;color:#d8e0ec}
.cr-modal{position:fixed;inset:0;background:rgba(0,0,0,.9);display:none;align-items:center;justify-content:center;padding:20px;z-index:9999}
.cr-modal.active{display:flex}
.cr-modal-card{background:linear-gradient(180deg,#0f1a35,#050810);border:2px solid #ffcc00;border-radius:16px;padding:22px;max-width:520px;width:100%;max-height:90vh;overflow-y:auto}
.cr-modal-title{font-family:'Anton',sans-serif;font-size:20px;letter-spacing:3px;color:#ffcc00;text-transform:uppercase;text-align:center;margin-bottom:14px}
.cr-substats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:14px}
.cr-substat{padding:14px 10px;border-radius:12px;text-align:center;background:linear-gradient(160deg,rgba(255,204,0,.1),rgba(0,0,0,.5));border:1px solid rgba(255,204,0,.3)}
.cr-substat .l{font-family:'Anton',sans-serif;font-size:9px;letter-spacing:2px;color:#ffcc00;text-transform:uppercase}
.cr-substat .v{font-family:'Anton',sans-serif;font-size:24px;color:#fff;margin-top:4px;line-height:1}
.tbl{width:100%;border-collapse:collapse;font-size:12px}
.tbl th{font-family:'Anton',sans-serif;font-size:9px;letter-spacing:1.5px;color:#ffcc00;text-transform:uppercase;padding:8px 6px;text-align:left;border-bottom:1px solid rgba(255,204,0,.3)}
.tbl td{padding:8px 6px;border-bottom:1px solid rgba(255,255,255,.05);font-weight:700;color:#d8e0ec}
.tbl tr.me td{background:rgba(255,204,0,.08)}
.tbl tr.cutoff td{border-bottom:2px solid #00ff88}
